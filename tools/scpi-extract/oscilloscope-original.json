{
  "instrument": "Rigol DS2202 oscilloscope (MSO2000A/DS2000A series)",
  "source": "Transcribed from the Rigol MSO2000A/DS2000A Programming Guide (Feb 2016). Scoped to the base DS2202 — MSO-only (:LA) and -S generator (:SOURce/:OUTPut/:TRACe) commands are omitted; protocol-decoder and option commands are summarized.",
  "commands": [
    { "category": "General", "syntax": ":AUToscale", "description": "Auto-set the vertical scale, timebase, and trigger to display the input signal (the AUTO key).", "example": ":AUToscale", "benchVerified": true },
    { "category": "General", "syntax": ":RUN", "description": "Start continuous acquisition.", "example": ":RUN", "benchVerified": true },
    { "category": "General", "syntax": ":STOP", "description": "Stop acquisition.", "example": ":STOP", "benchVerified": true },
    { "category": "General", "syntax": ":SINGle", "description": "Single-trigger mode: trigger once when the condition is met, then stop.", "example": ":SINGle", "benchVerified": true },
    { "category": "General", "syntax": ":CLEar", "description": "Clear all waveforms from the screen (new ones appear if running).", "example": ":CLEar" },
    { "category": "General", "syntax": ":TFORce", "description": "Force a trigger (the FORCE key).", "example": ":TFORce" },
    { "category": "General", "syntax": ":TLHAlf", "description": "Set the trigger level to the vertical midpoint of the trigger signal.", "example": ":TLHAlf" },

    { "category": "IEEE 488.2 Common", "syntax": "*IDN?", "description": "Identify the instrument: manufacturer, model, serial number, firmware/hardware version.", "example": "*IDN?", "isQuery": true, "benchVerified": true },
    { "category": "IEEE 488.2 Common", "syntax": "*CLS", "description": "Clear all event registers and the error queue.", "example": "*CLS", "benchVerified": true },
    { "category": "IEEE 488.2 Common", "syntax": "*RST", "description": "Reset the oscilloscope to its factory default state.", "example": "*RST" },
    { "category": "IEEE 488.2 Common", "syntax": "*ESE <mask>", "description": "Set or query the standard event status enable register (0-255).", "example": "*ESE 16" },
    { "category": "IEEE 488.2 Common", "syntax": "*ESR?", "description": "Query and clear the standard event status register.", "example": "*ESR?", "isQuery": true },
    { "category": "IEEE 488.2 Common", "syntax": "*OPC", "description": "Set the operation-complete bit when the current operation finishes; *OPC? returns 1 when done.", "example": "*OPC?" },
    { "category": "IEEE 488.2 Common", "syntax": "*SRE <mask>", "description": "Set or query the status-byte enable register (0-255).", "example": "*SRE 16" },
    { "category": "IEEE 488.2 Common", "syntax": "*STB?", "description": "Query the status byte register.", "example": "*STB?", "isQuery": true },
    { "category": "IEEE 488.2 Common", "syntax": "*TST?", "description": "Run a self-test and return the result (0 = all passed).", "example": "*TST?", "isQuery": true },

    { "category": "Acquire", "syntax": ":ACQuire:TYPE <NORMal|AVERages|PEAK|HRESolution>", "description": "Set or query the acquisition mode.", "example": ":ACQuire:TYPE NORMal" },
    { "category": "Acquire", "syntax": ":ACQuire:AVERages <count>", "description": "Set or query the number of averages in average mode (a power of two, 2 to 8192).", "example": ":ACQuire:AVERages 16" },
    { "category": "Acquire", "syntax": ":ACQuire:MDEPth <mdep>", "description": "Set or query the memory depth in points (AUTO|14000|140000|1400000|14000000, or half those non-interleaved).", "example": ":ACQuire:MDEPth AUTO" },
    { "category": "Acquire", "syntax": ":ACQuire:SRATe?", "description": "Query the current sample rate (Sa/s).", "example": ":ACQuire:SRATe?", "isQuery": true },
    { "category": "Acquire", "syntax": ":ACQuire:AALias <ON|OFF>", "description": "Enable or disable anti-aliasing.", "example": ":ACQuire:AALias ON" },

    { "category": "Channel", "syntax": ":CHANnel<n>:DISPlay <ON|OFF>", "description": "Turn analog channel n on or off.", "example": ":CHANnel1:DISPlay ON", "benchVerified": true },
    { "category": "Channel", "syntax": ":CHANnel<n>:SCALe <scale>", "description": "Set or query the vertical scale in volts/div.", "example": ":CHANnel1:SCALe 0.5", "benchVerified": true },
    { "category": "Channel", "syntax": ":CHANnel<n>:OFFSet <offset>", "description": "Set or query the vertical offset in volts.", "example": ":CHANnel1:OFFSet 0" },
    { "category": "Channel", "syntax": ":CHANnel<n>:COUPling <AC|DC|GND>", "description": "Set or query the channel input coupling.", "example": ":CHANnel1:COUPling DC" },
    { "category": "Channel", "syntax": ":CHANnel<n>:BWLimit <20M|100M|OFF>", "description": "Set or query the channel bandwidth limit (100 MHz models limit to 20 MHz).", "example": ":CHANnel1:BWLimit OFF" },
    { "category": "Channel", "syntax": ":CHANnel<n>:PROBe <atten>", "description": "Set or query the probe attenuation ratio (0.01, 0.02, … 100, 200, 500, 1000).", "example": ":CHANnel1:PROBe 10" },
    { "category": "Channel", "syntax": ":CHANnel<n>:IMPedance <OMEG|FIFTy>", "description": "Set or query the input impedance: 1 MΩ or 50 Ω.", "example": ":CHANnel1:IMPedance OMEG" },
    { "category": "Channel", "syntax": ":CHANnel<n>:INVert <ON|OFF>", "description": "Invert or restore the channel display.", "example": ":CHANnel1:INVert OFF" },
    { "category": "Channel", "syntax": ":CHANnel<n>:UNITs <VOLTage|WATT|AMPere|UNKNown>", "description": "Set or query the channel amplitude display unit.", "example": ":CHANnel1:UNITs VOLTage" },
    { "category": "Channel", "syntax": ":CHANnel<n>:VERNier <ON|OFF>", "description": "Enable or disable fine (vernier) vertical-scale adjustment.", "example": ":CHANnel1:VERNier OFF" },
    { "category": "Channel", "syntax": ":CHANnel<n>:TCAL <time>", "description": "Set or query the channel delay-calibration time (-200 ns to 200 ns).", "example": ":CHANnel1:TCAL 0" },

    { "category": "Timebase", "syntax": ":TIMebase:MODE <MAIN|XY|ROLL>", "description": "Set or query the horizontal timebase mode.", "example": ":TIMebase:MODE MAIN" },
    { "category": "Timebase", "syntax": ":TIMebase:MAIN:SCALe <scale>", "description": "Set or query the main timebase in seconds/div.", "example": ":TIMebase:MAIN:SCALe 0.001" },
    { "category": "Timebase", "syntax": ":TIMebase:MAIN:OFFSet <offset>", "description": "Set or query the main timebase horizontal offset in seconds.", "example": ":TIMebase:MAIN:OFFSet 0" },
    { "category": "Timebase", "syntax": ":TIMebase:DELay:ENABle <ON|OFF>", "description": "Enable or disable the delayed-sweep (zoom) window.", "example": ":TIMebase:DELay:ENABle ON" },
    { "category": "Timebase", "syntax": ":TIMebase:DELay:SCALe <scale>", "description": "Set or query the delayed-sweep timebase in seconds/div.", "example": ":TIMebase:DELay:SCALe 5e-7" },
    { "category": "Timebase", "syntax": ":TIMebase:DELay:OFFSet <offset>", "description": "Set or query the delayed-sweep horizontal offset in seconds.", "example": ":TIMebase:DELay:OFFSet 0" },
    { "category": "Timebase", "syntax": ":TIMebase:HREF:MODE <CENTer|TPOSition|USER>", "description": "Set or query the horizontal expansion reference.", "example": ":TIMebase:HREF:MODE CENTer" },
    { "category": "Timebase", "syntax": ":TIMebase:HREF:POSition <pos>", "description": "Set or query the user horizontal reference position (-350 to 350).", "example": ":TIMebase:HREF:POSition 0" },
    { "category": "Timebase", "syntax": ":TIMebase:VERNier <ON|OFF>", "description": "Enable or disable fine (vernier) timebase adjustment.", "example": ":TIMebase:VERNier OFF" },

    { "category": "Trigger", "syntax": ":TRIGger:MODE <type>", "description": "Set or query the trigger type: EDGE, PULSe, RUNT, WIND, NEDG, SLOPe, VIDeo, PATTern, DELay, TIMeout, DURATion, SHOLd, RS232, IIC, SPI, USB, CAN.", "example": ":TRIGger:MODE EDGE" },
    { "category": "Trigger", "syntax": ":TRIGger:SWEep <AUTO|NORMal|SINGle>", "description": "Set or query the trigger sweep mode.", "example": ":TRIGger:SWEep AUTO" },
    { "category": "Trigger", "syntax": ":TRIGger:COUPling <DC|AC|LFReject|HFReject>", "description": "Set or query the trigger coupling (edge trigger).", "example": ":TRIGger:COUPling DC" },
    { "category": "Trigger", "syntax": ":TRIGger:HOLDoff <value>", "description": "Set or query the trigger holdoff time (100 ns to 10 s).", "example": ":TRIGger:HOLDoff 1e-7" },
    { "category": "Trigger", "syntax": ":TRIGger:NREJect <ON|OFF>", "description": "Enable or disable trigger noise rejection.", "example": ":TRIGger:NREJect OFF" },
    { "category": "Trigger", "syntax": ":TRIGger:STATus?", "description": "Query the trigger status: TD, WAIT, RUN, AUTO, or STOP.", "example": ":TRIGger:STATus?", "isQuery": true },
    { "category": "Trigger", "syntax": ":TRIGger:EDGe:SOURce <src>", "description": "Set or query the edge-trigger source (CHANnel1|CHANnel2|EXT|ACLine|D0-D15).", "example": ":TRIGger:EDGe:SOURce CHANnel1" },
    { "category": "Trigger", "syntax": ":TRIGger:EDGe:SLOPe <POSitive|NEGative|RFALl>", "description": "Set or query the edge-trigger slope.", "example": ":TRIGger:EDGe:SLOPe POSitive" },
    { "category": "Trigger", "syntax": ":TRIGger:EDGe:LEVel <level>", "description": "Set or query the edge-trigger level in volts.", "example": ":TRIGger:EDGe:LEVel 0" },
    { "category": "Trigger", "syntax": ":TRIGger:PULSe:SOURce <src>", "description": "Set or query the pulse-width-trigger source.", "example": ":TRIGger:PULSe:SOURce CHANnel1" },
    { "category": "Trigger", "syntax": ":TRIGger:PULSe:WHEN <when>", "description": "Set or query the pulse-width qualifying condition (e.g. PGReater, PLESs, NGReater, NLESs).", "example": ":TRIGger:PULSe:WHEN PGReater" },
    { "category": "Trigger", "syntax": ":TRIGger:PULSe:LEVel <level>", "description": "Set or query the pulse-width-trigger level in volts.", "example": ":TRIGger:PULSe:LEVel 0" },
    { "category": "Trigger", "syntax": ":TRIGger:SLOPe:SOURce <src>", "description": "Set or query the slope-trigger source.", "example": ":TRIGger:SLOPe:SOURce CHANnel1" },
    { "category": "Trigger", "syntax": ":TRIGger:VIDeo:SOURce <src>", "description": "Set or query the video-trigger source.", "example": ":TRIGger:VIDeo:SOURce CHANnel1" },
    { "category": "Trigger", "syntax": ":TRIGger:VIDeo:STANdard <std>", "description": "Set or query the video standard (e.g. NTSC, PALSecam, 480P, 576P).", "example": ":TRIGger:VIDeo:STANdard NTSC" },
    { "category": "Trigger", "syntax": ":TRIGger:PATTern:PATTern <p1>,<p2>...", "description": "Set or query the pattern-trigger pattern for each channel (H, L, X, R, F).", "example": ":TRIGger:PATTern:PATTern H,L,X,X" },

    { "category": "Measure", "syntax": ":MEASure:SOURce <src>", "description": "Set or query the measurement source (CHANnel1|CHANnel2|MATH|D0-D15).", "example": ":MEASure:SOURce CHANnel1" },
    { "category": "Measure", "syntax": ":MEASure:VPP? [<src>]", "description": "Query the peak-to-peak voltage.", "example": ":MEASure:VPP? CHANnel1", "isQuery": true, "benchVerified": true },
    { "category": "Measure", "syntax": ":MEASure:FREQuency? [<src>]", "description": "Query the frequency.", "example": ":MEASure:FREQuency? CHANnel1", "isQuery": true, "benchVerified": true },
    { "category": "Measure", "syntax": ":MEASure:VMAX? [<src>]", "description": "Query the maximum voltage.", "example": ":MEASure:VMAX? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VMIN? [<src>]", "description": "Query the minimum voltage.", "example": ":MEASure:VMIN? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VTOP? [<src>]", "description": "Query the top (flat-top) voltage.", "example": ":MEASure:VTOP? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VBASe? [<src>]", "description": "Query the base voltage.", "example": ":MEASure:VBASe? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VAMP? [<src>]", "description": "Query the amplitude (top − base).", "example": ":MEASure:VAMP? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VAVG? [<src>]", "description": "Query the average voltage.", "example": ":MEASure:VAVG? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:VRMS? [<src>]", "description": "Query the RMS voltage.", "example": ":MEASure:VRMS? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:OVERshoot? [<src>]", "description": "Query the overshoot (%).", "example": ":MEASure:OVERshoot? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:PREShoot? [<src>]", "description": "Query the preshoot (%).", "example": ":MEASure:PREShoot? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:PERiod? [<src>]", "description": "Query the period.", "example": ":MEASure:PERiod? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:RTIMe? [<src>]", "description": "Query the rise time.", "example": ":MEASure:RTIMe? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:FTIMe? [<src>]", "description": "Query the fall time.", "example": ":MEASure:FTIMe? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:PWIDth? [<src>]", "description": "Query the positive pulse width.", "example": ":MEASure:PWIDth? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:NWIDth? [<src>]", "description": "Query the negative pulse width.", "example": ":MEASure:NWIDth? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:PDUTy? [<src>]", "description": "Query the positive duty cycle (%).", "example": ":MEASure:PDUTy? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:NDUTy? [<src>]", "description": "Query the negative duty cycle (%).", "example": ":MEASure:NDUTy? CHANnel1", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:CLEar <ITEM1|ITEM2|ITEM3|ITEM4|ITEM5|ALL>", "description": "Clear one or all of the displayed measurement items.", "example": ":MEASure:CLEar ALL" },
    { "category": "Measure", "syntax": ":MEASure:ADISplay <ON|OFF>", "description": "Enable or disable the all-parameters measurement display.", "example": ":MEASure:ADISplay ON" },
    { "category": "Measure", "syntax": ":MEASure:COUNter:SOURce <src|OFF>", "description": "Set or query the frequency-counter source, or OFF to disable it.", "example": ":MEASure:COUNter:SOURce CHANnel1" },
    { "category": "Measure", "syntax": ":MEASure:COUNter:VALue?", "description": "Query the frequency-counter reading (Hz).", "example": ":MEASure:COUNter:VALue?", "isQuery": true },
    { "category": "Measure", "syntax": ":MEASure:STATistic:DISPlay <ON|OFF>", "description": "Enable or disable measurement statistics.", "example": ":MEASure:STATistic:DISPlay ON" },
    { "category": "Measure", "syntax": ":MEASure:STATistic:MODE <DIFFerence|EXTRemum>", "description": "Set or query the measurement statistics mode.", "example": ":MEASure:STATistic:MODE EXTRemum" },
    { "category": "Measure", "syntax": ":MEASure:STATistic:RESet", "description": "Reset (clear and restart) the measurement statistics.", "example": ":MEASure:STATistic:RESet" },

    { "category": "Waveform", "syntax": ":WAVeform:SOURce <src>", "description": "Set or query the source of waveform-data reads (CHANnel1|CHANnel2|MATH|D0-D15).", "example": ":WAVeform:SOURce CHANnel1" },
    { "category": "Waveform", "syntax": ":WAVeform:MODE <NORMal|MAXimum|RAW>", "description": "Set or query the waveform reading mode (screen vs. deep memory).", "example": ":WAVeform:MODE NORMal" },
    { "category": "Waveform", "syntax": ":WAVeform:FORMat <WORD|BYTE|ASCii>", "description": "Set or query the returned data format.", "example": ":WAVeform:FORMat BYTE" },
    { "category": "Waveform", "syntax": ":WAVeform:POINts <point>", "description": "Set or query the number of waveform points to read.", "example": ":WAVeform:POINts 1400" },
    { "category": "Waveform", "syntax": ":WAVeform:DATA?", "description": "Read the waveform data as an IEEE 488.2 binary block (used by Capture Waveform).", "example": ":WAVeform:DATA?", "isQuery": true },
    { "category": "Waveform", "syntax": ":WAVeform:PREamble?", "description": "Query the 10 scaling parameters (format,type,points,count,xinc,xorig,xref,yinc,yorig,yref).", "example": ":WAVeform:PREamble?", "isQuery": true },
    { "category": "Waveform", "syntax": ":WAVeform:XINCrement?", "description": "Query the time between adjacent samples (s).", "example": ":WAVeform:XINCrement?", "isQuery": true },
    { "category": "Waveform", "syntax": ":WAVeform:YINCrement?", "description": "Query the voltage per level unit (V).", "example": ":WAVeform:YINCrement?", "isQuery": true },
    { "category": "Waveform", "syntax": ":WAVeform:STARt <sta>", "description": "Set or query the start point for memory reads.", "example": ":WAVeform:STARt 1" },
    { "category": "Waveform", "syntax": ":WAVeform:STOP <sto>", "description": "Set or query the stop point for memory reads.", "example": ":WAVeform:STOP 1400" },
    { "category": "Waveform", "syntax": ":WAVeform:STATus?", "description": "Query the waveform reading status (IDLE,n or READ,n).", "example": ":WAVeform:STATus?", "isQuery": true },

    { "category": "Display", "syntax": ":DISPlay:DATA?", "description": "Read the screen image as a BMP binary block (used by Capture Screen).", "example": ":DISPlay:DATA?", "isQuery": true },
    { "category": "Display", "syntax": ":DISPlay:CLEar", "description": "Clear all waveforms from the screen.", "example": ":DISPlay:CLEar" },
    { "category": "Display", "syntax": ":DISPlay:TYPE <VECTors|DOTS>", "description": "Set or query the waveform draw style (connected vectors or dots).", "example": ":DISPlay:TYPE VECTors" },
    { "category": "Display", "syntax": ":DISPlay:GRADing:TIME <time>", "description": "Set or query the persistence time (MIN|0.05|0.1|0.2|0.5|1|2|5|10|20|INFinite).", "example": ":DISPlay:GRADing:TIME MIN" },
    { "category": "Display", "syntax": ":DISPlay:GRID <FULL|HALF|NONE>", "description": "Set or query the screen grid type.", "example": ":DISPlay:GRID FULL" },
    { "category": "Display", "syntax": ":DISPlay:GBRightness <0-100>", "description": "Set or query the grid brightness (%).", "example": ":DISPlay:GBRightness 50" },
    { "category": "Display", "syntax": ":DISPlay:WBRightness <0-100>", "description": "Set or query the waveform brightness (%).", "example": ":DISPlay:WBRightness 50" },

    { "category": "Cursor", "syntax": ":CURSor:MODE <OFF|MANual|TRACk|AUTO|XY>", "description": "Set or query the cursor measurement mode.", "example": ":CURSor:MODE MANual" },
    { "category": "Cursor", "syntax": ":CURSor:MANual:TYPE <X|Y>", "description": "Set or query the manual-cursor type (time or voltage cursors).", "example": ":CURSor:MANual:TYPE X" },
    { "category": "Cursor", "syntax": ":CURSor:TRACk:SOURce1 <src>", "description": "Set or query the source tracked by cursor A in track mode.", "example": ":CURSor:TRACk:SOURce1 CHANnel1" },

    { "category": "Math", "syntax": ":CALCulate:MODE <ADD|SUB|MULTiply|DIVision|FFT|LOGic|ADVanced>", "description": "Set or query the math operation.", "example": ":CALCulate:MODE FFT" },
    { "category": "Math", "syntax": ":CALCulate:FFT:SOURce <src>", "description": "Set or query the FFT source channel.", "example": ":CALCulate:FFT:SOURce CHANnel1" },
    { "category": "Math", "syntax": ":CALCulate:FFT:WINDow <window>", "description": "Set or query the FFT window (RECTangle, HANNing, HAMMing, BLACkman).", "example": ":CALCulate:FFT:WINDow HANNing" },
    { "category": "Math", "syntax": ":CALCulate:ADVanced:EXPRession <expr>", "description": "Set or query the advanced-math expression.", "example": ":CALCulate:ADVanced:EXPRession (CH1+CH2)" },

    { "category": "Reference", "syntax": ":REFerence:DISPlay <ON|OFF>", "description": "Enable or disable the reference-waveform display.", "example": ":REFerence:DISPlay ON" },
    { "category": "Reference", "syntax": ":REFerence<n>:ENABle <ON|OFF>", "description": "Enable or disable reference channel n.", "example": ":REFerence1:ENABle ON" },
    { "category": "Reference", "syntax": ":REFerence<n>:SOURce <src>", "description": "Set or query the source stored into reference channel n.", "example": ":REFerence1:SOURce CHANnel1" },
    { "category": "Reference", "syntax": ":REFerence<n>:SAVe", "description": "Save the current source into reference channel n.", "example": ":REFerence1:SAVe" },
    { "category": "Reference", "syntax": ":REFerence:RESet", "description": "Reset the reference-waveform position.", "example": ":REFerence:RESet" },

    { "category": "Save/Recall", "syntax": ":SAVE:IMAGe:STARt", "description": "Save a screen image to the current storage location.", "example": ":SAVE:IMAGe:STARt" },
    { "category": "Save/Recall", "syntax": ":SAVE:WAVeform:STARt", "description": "Save the waveform to the current storage location.", "example": ":SAVE:WAVeform:STARt" },
    { "category": "Save/Recall", "syntax": ":SAVE:CSV:STARt", "description": "Save the waveform data as CSV.", "example": ":SAVE:CSV:STARt" },
    { "category": "Save/Recall", "syntax": ":SAVE:SETup:STARt", "description": "Save the instrument setup.", "example": ":SAVE:SETup:STARt" },
    { "category": "Save/Recall", "syntax": ":RECall:SETup <path>", "description": "Recall a saved instrument setup.", "example": ":RECall:SETup" },

    { "category": "System", "syntax": ":SYSTem:ERRor:NEXT?", "description": "Query and clear the next error from the error queue.", "example": ":SYSTem:ERRor:NEXT?", "isQuery": true },
    { "category": "System", "syntax": ":SYSTem:BEEPer <ON|OFF>", "description": "Enable or disable the beeper.", "example": ":SYSTem:BEEPer OFF" },
    { "category": "System", "syntax": ":SYSTem:AUToscale <ON|OFF>", "description": "Enable or disable the AUTO (auto-scale) function.", "example": ":SYSTem:AUToscale ON" },
    { "category": "System", "syntax": ":SYSTem:DATE <year>,<month>,<day>", "description": "Set or query the system date.", "example": ":SYSTem:DATE 2026,7,29" },
    { "category": "System", "syntax": ":SYSTem:TIME <hour>,<minute>,<second>", "description": "Set or query the system time.", "example": ":SYSTem:TIME 12,0,0" },
    { "category": "System", "syntax": ":SYSTem:LANGuage <lang>", "description": "Set or query the UI language.", "example": ":SYSTem:LANGuage ENGLish" },
    { "category": "System", "syntax": ":SYSTem:PON <LATest|DEFault>", "description": "Set or query the power-on setup source.", "example": ":SYSTem:PON DEFault" },
    { "category": "System", "syntax": ":SYSTem:VERSion?", "description": "Query the SCPI version the instrument conforms to.", "example": ":SYSTem:VERSion?", "isQuery": true },
    { "category": "System", "syntax": ":SYSTem:KEY:PRESs <key>", "description": "Simulate pressing a front-panel key.", "example": ":SYSTem:KEY:PRESs RUN" },
    { "category": "System", "syntax": ":SYSTem:RESet", "description": "Reset the oscilloscope to the default state.", "example": ":SYSTem:RESet" },

    { "category": "LAN", "syntax": ":LAN:DHCP <ON|OFF>", "description": "Enable or disable DHCP addressing.", "example": ":LAN:DHCP ON" },
    { "category": "LAN", "syntax": ":LAN:AUToip <ON|OFF>", "description": "Enable or disable auto-IP addressing.", "example": ":LAN:AUToip ON" },
    { "category": "LAN", "syntax": ":LAN:MANual <ON|OFF>", "description": "Enable or disable static (manual) addressing.", "example": ":LAN:MANual OFF" },
    { "category": "LAN", "syntax": ":LAN:IPADdress <ip>", "description": "Set or query the static IP address.", "example": ":LAN:IPADdress 192.168.1.19" },
    { "category": "LAN", "syntax": ":LAN:SMASk <mask>", "description": "Set or query the subnet mask.", "example": ":LAN:SMASk 255.255.255.0" },
    { "category": "LAN", "syntax": ":LAN:GATeway <gateway>", "description": "Set or query the default gateway.", "example": ":LAN:GATeway 192.168.1.1" },
    { "category": "LAN", "syntax": ":LAN:MAC?", "description": "Query the MAC address.", "example": ":LAN:MAC?", "isQuery": true },
    { "category": "LAN", "syntax": ":LAN:STATus?", "description": "Query the network connection status.", "example": ":LAN:STATus?", "isQuery": true },
    { "category": "LAN", "syntax": ":LAN:VISA?", "description": "Query the instrument's VISA resource string.", "example": ":LAN:VISA?", "isQuery": true },
