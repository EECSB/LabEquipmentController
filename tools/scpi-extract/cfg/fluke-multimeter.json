{
  "instrument": "Fluke multimeter (8845A / 8846A)",
  "source": "Transcribed by hand from the Fluke 8845A/8846A Digital Multimeter Programmers Manual (September 2006). The guide's command reference is a set of indented tree tables whose description column pdftotext shifts by a row in places — Table 12 pairs ':DIODe?' with 'Make a frequency measurement' — so these entries were read off and paired by eye rather than extracted, and the ':CURRent:VOLTage' style nonsense an automatic pass produced was discarded. Cross-checked against pymeasure fluke and the Keysight 34401A set, which this meter follows closely.",
  "groups": [],
  "commonCommands": ["*CLS", "*ESE", "*ESE?", "*ESR?", "*IDN?", "*OPC", "*OPC?", "*PSC", "*PSC?", "*RST", "*SRE", "*SRE?", "*STB?", "*TRG", "*TST?", "*WAI"],
  "supplements": [
    { "category": "Measure", "syntax": "MEASure[:VOLTage][:DC]? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a dc voltage measurement.", "example": "MEASure:VOLTage:DC?" },
    { "category": "Measure", "syntax": "MEASure[:VOLTage]:AC? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make an ac voltage measurement.", "example": "MEASure:VOLTage:AC?" },
    { "category": "Measure", "syntax": "MEASure:CURRent[:DC]? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a dc current measurement.", "example": "MEASure:CURRent:DC?" },
    { "category": "Measure", "syntax": "MEASure:CURRent:AC? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make an ac current measurement.", "example": "MEASure:CURRent:AC?" },
    { "category": "Measure", "syntax": "MEASure:RESistance? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a 2-wire resistance measurement.", "example": "MEASure:RESistance?" },
    { "category": "Measure", "syntax": "MEASure:FRESistance? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a 4-wire resistance measurement.", "example": "MEASure:FRESistance?" },
    { "category": "Measure", "syntax": "MEASure:FREQuency? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a frequency measurement.", "example": "MEASure:FREQuency?" },
    { "category": "Measure", "syntax": "MEASure:PERiod? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a period measurement.", "example": "MEASure:PERiod?" },
    { "category": "Measure", "syntax": "MEASure:CAPacitance? [{<range>|MIN|MAX|DEF}[,{<resolution>|MIN|MAX|DEF}]]", "description": "Preset and make a capacitance measurement. 8846A only.", "example": "MEASure:CAPacitance?" },
    { "category": "Measure", "syntax": "MEASure:CONTinuity?", "description": "Preset and make a continuity measurement.", "example": "MEASure:CONTinuity?" },
    { "category": "Measure", "syntax": "MEASure:DIODe? [{<low current>}][,{<high voltage>}]", "description": "Preset and make a diode measurement.", "example": "MEASure:DIODe?" },
    { "category": "Measure", "syntax": "MEASure:TEMPerature:RTD? [{<RTD type>}]", "description": "Preset and make a 2-wire temperature measurement. 8846A only.", "example": "MEASure:TEMPerature:RTD?" },
    { "category": "Measure", "syntax": "MEASure:TEMPerature:FRTD? [{<RTD type>}]", "description": "Preset and make a 4-wire temperature measurement. 8846A only.", "example": "MEASure:TEMPerature:FRTD?" },

    { "category": "Configure", "syntax": "CONFigure?", "description": "Retrieve the present meter configuration.", "example": "CONFigure?" },
    { "category": "Configure", "syntax": "CONFigure[:VOLTage][:DC] [{<range>}[,{<resolution>}]]", "description": "Select the dc volts function without triggering a reading.", "example": "CONFigure:VOLTage:DC" },
    { "category": "Configure", "syntax": "CONFigure[:VOLTage]:AC [{<range>}[,{<resolution>}]]", "description": "Select the ac volts function without triggering a reading.", "example": "CONFigure:VOLTage:AC" },
    { "category": "Configure", "syntax": "CONFigure:CURRent[:DC] [{<range>}[,{<resolution>}]]", "description": "Select the dc current function without triggering a reading.", "example": "CONFigure:CURRent:DC" },
    { "category": "Configure", "syntax": "CONFigure:CURRent:AC [{<range>}[,{<resolution>}]]", "description": "Select the ac current function without triggering a reading.", "example": "CONFigure:CURRent:AC" },
    { "category": "Configure", "syntax": "CONFigure:RESistance [{<range>}[,{<resolution>}]]", "description": "Select the 2-wire resistance function.", "example": "CONFigure:RESistance" },
    { "category": "Configure", "syntax": "CONFigure:FRESistance [{<range>}[,{<resolution>}]]", "description": "Select the 4-wire resistance function.", "example": "CONFigure:FRESistance" },
    { "category": "Configure", "syntax": "CONFigure:FREQuency [{<range>}[,{<resolution>}]]", "description": "Select the frequency function.", "example": "CONFigure:FREQuency" },
    { "category": "Configure", "syntax": "CONFigure:PERiod [{<range>}[,{<resolution>}]]", "description": "Select the period function.", "example": "CONFigure:PERiod" },
    { "category": "Configure", "syntax": "CONFigure:CAPacitance [{<range>}[,{<resolution>}]]", "description": "Select the capacitance function. 8846A only.", "example": "CONFigure:CAPacitance" },
    { "category": "Configure", "syntax": "CONFigure:CONTinuity", "description": "Select the continuity function.", "example": "CONFigure:CONTinuity" },
    { "category": "Configure", "syntax": "CONFigure:DIODe [{<low current>}][,{<high voltage>}]", "description": "Select the diode function.", "example": "CONFigure:DIODe" },
    { "category": "Configure", "syntax": "CONFigure:TEMPerature:RTD [{<RTD type>}]", "description": "Select the 2-wire temperature function. 8846A only.", "example": "CONFigure:TEMPerature:RTD" },
    { "category": "Configure", "syntax": "CONFigure:TEMPerature:FRTD [{<RTD type>}]", "description": "Select the 4-wire temperature function. 8846A only.", "example": "CONFigure:TEMPerature:FRTD" },

    { "category": "Sense — Function", "syntax": "[SENSe:]FUNCtion1 \"<function>\"", "description": "Select the function shown on the primary display, as a quoted string such as \"VOLTage:DC\" or \"RESistance\".", "example": "FUNCtion1 \"VOLTage:DC\"" },
    { "category": "Sense — Function", "syntax": "[SENSe:]FUNCtion2 \"<function>\"", "description": "Select the function shown on the secondary display. \"None\" turns the secondary display off.", "example": "FUNCtion2 \"None\"" },
    { "category": "Sense — Function", "syntax": "[SENSe:]FUNCtion1?", "description": "Retrieve the present primary measurement function.", "example": "FUNCtion1?" },
    { "category": "Sense — Function", "syntax": "[SENSe:]FUNCtion2?", "description": "Retrieve the present secondary measurement function.", "example": "FUNCtion2?" },

    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:BANDwidth {3|20|200|MINimum|MAXimum}", "description": "Select the ac voltage filter, in hertz.", "example": "VOLTage:AC:BANDwidth 20" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:BANDwidth?", "description": "Retrieve the present ac voltage filter setting.", "example": "VOLTage:AC:BANDwidth?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:RANGe {<range>|MINimum|MAXimum}", "description": "Set the ac voltage range.", "example": "VOLTage:AC:RANGe 10" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:RANGe? [MINimum|MAXimum]", "description": "Retrieve the present ac voltage range setting.", "example": "VOLTage:AC:RANGe?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:RANGe:AUTO {OFF|ON}", "description": "Disable or enable ac voltage autoranging.", "example": "VOLTage:AC:RANGe:AUTO ON" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:RANGe:AUTO?", "description": "Retrieve the present ac voltage autorange setting.", "example": "VOLTage:AC:RANGe:AUTO?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage:AC:RESolution {<resolution>|MINimum|MAXimum}", "description": "Set the resolution for ac voltage measurements.", "example": "VOLTage:AC:RESolution MAXimum" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:RANGe {<range>|MINimum|MAXimum}", "description": "Set the dc voltage range.", "example": "VOLTage:DC:RANGe 10" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:RANGe? [MINimum|MAXimum]", "description": "Retrieve the present dc voltage range setting.", "example": "VOLTage:DC:RANGe?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:RANGe:AUTO {OFF|ON}", "description": "Disable or enable dc voltage autoranging.", "example": "VOLTage:DC:RANGe:AUTO ON" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:RANGe:AUTO?", "description": "Retrieve the present dc voltage autorange setting.", "example": "VOLTage:DC:RANGe:AUTO?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:RESolution {<resolution>|MINimum|MAXimum}", "description": "Set the resolution for dc voltage measurements.", "example": "VOLTage:DC:RESolution MAXimum" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:NPLC {<PLC>|MINimum|MAXimum}", "description": "Set the integration time in power-line cycles — higher is slower but quieter.", "example": "VOLTage:DC:NPLC 10" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:NPLC? [MINimum|MAXimum]", "description": "Retrieve the present integration time.", "example": "VOLTage:DC:NPLC?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:FILTer[:STATe] {OFF|ON}", "description": "Activate or deactivate the 3-pole analog filter.", "example": "VOLTage:DC:FILTer:STATe ON" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:FILTer[:STATe]?", "description": "Retrieve the present analog filter setting.", "example": "VOLTage:DC:FILTer:STATe?" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:FILTer:DIGItal[:STATe] {OFF|ON}", "description": "Activate or deactivate the digital filter.", "example": "VOLTage:DC:FILTer:DIGItal:STATe ON" },
    { "category": "Sense — Voltage", "syntax": "[SENSe:]VOLTage[:DC]:FILTer:DIGItal[:STATe]?", "description": "Retrieve the present digital filter setting.", "example": "VOLTage:DC:FILTer:DIGItal:STATe?" },

    { "category": "Sense — Current", "syntax": "[SENSe:]CURRent:AC:RANGe {<range>|MINimum|MAXimum}", "description": "Set the ac current range.", "example": "CURRent:AC:RANGe 1" },
    { "category": "Sense — Current", "syntax": "[SENSe:]CURRent:AC:RANGe:AUTO {OFF|ON}", "description": "Disable or enable ac current autoranging.", "example": "CURRent:AC:RANGe:AUTO ON" },
    { "category": "Sense — Current", "syntax": "[SENSe:]CURRent[:DC]:RANGe {<range>|MINimum|MAXimum}", "description": "Set the dc current range.", "example": "CURRent:DC:RANGe 1" },
    { "category": "Sense — Current", "syntax": "[SENSe:]CURRent[:DC]:RANGe:AUTO {OFF|ON}", "description": "Disable or enable dc current autoranging.", "example": "CURRent:DC:RANGe:AUTO ON" },
    { "category": "Sense — Current", "syntax": "[SENSe:]CURRent[:DC]:NPLC {<PLC>|MINimum|MAXimum}", "description": "Set the integration time for dc current, in power-line cycles.", "example": "CURRent:DC:NPLC 10" },

    { "category": "Sense — Resistance", "syntax": "[SENSe:]RESistance:RANGe {<range>|MINimum|MAXimum}", "description": "Set the 2-wire resistance range.", "example": "RESistance:RANGe 1000" },
    { "category": "Sense — Resistance", "syntax": "[SENSe:]RESistance:RANGe:AUTO {OFF|ON}", "description": "Disable or enable 2-wire resistance autoranging.", "example": "RESistance:RANGe:AUTO ON" },
    { "category": "Sense — Resistance", "syntax": "[SENSe:]RESistance:NPLC {<PLC>|MINimum|MAXimum}", "description": "Set the integration time for 2-wire resistance, in power-line cycles.", "example": "RESistance:NPLC 10" },
    { "category": "Sense — Resistance", "syntax": "[SENSe:]FRESistance:RANGe {<range>|MINimum|MAXimum}", "description": "Set the 4-wire resistance range.", "example": "FRESistance:RANGe 1000" },
    { "category": "Sense — Resistance", "syntax": "[SENSe:]FRESistance:RANGe:AUTO {OFF|ON}", "description": "Disable or enable 4-wire resistance autoranging.", "example": "FRESistance:RANGe:AUTO ON" },

    { "category": "Acquisition", "syntax": "READ?", "description": "Set the trigger system to wait-for-trigger, then take a reading and return it.", "example": "READ?" },
    { "category": "Acquisition", "syntax": "INITiate", "description": "Set the trigger system to wait-for-trigger and store readings in memory.", "example": "INITiate" },
    { "category": "Acquisition", "syntax": "FETCh?", "description": "Transfer stored readings to the output buffer. The guide writes this FETCh[1|2]?, where the suffix picks the display.", "example": "FETCh?" },
    { "category": "Acquisition", "syntax": "FETCh2?", "description": "Transfer stored readings from the secondary display to the output buffer.", "example": "FETCh2?" },
    { "category": "Acquisition", "syntax": "ABORt", "description": "Abort a measurement in progress.", "example": "ABORt" },
    { "category": "Acquisition", "syntax": "DATA:POINts?", "description": "Retrieve the number of readings stored in memory.", "example": "DATA:POINts?" },
    { "category": "Acquisition", "syntax": "R? [<max readings>]", "description": "Read and clear up to the given number of stored readings.", "example": "R? 10" },
    { "category": "Acquisition", "syntax": "SAMPle:COUNt {<count>|MINimum|MAXimum}", "description": "Set how many readings are taken per trigger.", "example": "SAMPle:COUNt 10" },
    { "category": "Acquisition", "syntax": "SAMPle:COUNt? [MINimum|MAXimum]", "description": "Retrieve the sample count.", "example": "SAMPle:COUNt?" },

    { "category": "Trigger", "syntax": "TRIGger:SOURce {BUS|IMMediate|EXTernal}", "description": "Set the trigger source.", "example": "TRIGger:SOURce IMMediate" },
    { "category": "Trigger", "syntax": "TRIGger:SOURce?", "description": "Retrieve the present trigger source.", "example": "TRIGger:SOURce?" },
    { "category": "Trigger", "syntax": "TRIGger:DELay {<seconds>|MINimum|MAXimum}", "description": "Set the delay between trigger and measurement.", "example": "TRIGger:DELay 0.1" },
    { "category": "Trigger", "syntax": "TRIGger:DELay? [MINimum|MAXimum]", "description": "Retrieve the trigger delay.", "example": "TRIGger:DELay?" },
    { "category": "Trigger", "syntax": "TRIGger:DELay:AUTO {OFF|ON}", "description": "Let the meter choose the trigger delay automatically.", "example": "TRIGger:DELay:AUTO ON" },
    { "category": "Trigger", "syntax": "TRIGger:COUNt {<count>|MINimum|MAXimum|INFinite}", "description": "Set how many triggers are accepted before returning to idle.", "example": "TRIGger:COUNt 1" },

    { "category": "Calculate", "syntax": "CALCulate:FUNCtion {NULL|DB|DBM|AVERage|LIMit}", "description": "Select the math function applied to readings.", "example": "CALCulate:FUNCtion NULL" },
    { "category": "Calculate", "syntax": "CALCulate:FUNCtion?", "description": "Retrieve the present math function.", "example": "CALCulate:FUNCtion?" },
    { "category": "Calculate", "syntax": "CALCulate:STATe {OFF|ON}", "description": "Disable or enable the selected math function.", "example": "CALCulate:STATe ON" },
    { "category": "Calculate", "syntax": "CALCulate:STATe?", "description": "Retrieve the state of the math function.", "example": "CALCulate:STATe?" },
    { "category": "Calculate", "syntax": "CALCulate:NULL:OFFSet {<value>|MINimum|MAXimum}", "description": "Set the null offset subtracted from readings.", "example": "CALCulate:NULL:OFFSet 0.1" },
    { "category": "Calculate", "syntax": "CALCulate:NULL:OFFSet? [MINimum|MAXimum]", "description": "Retrieve the null offset value.", "example": "CALCulate:NULL:OFFSet?" },
    { "category": "Calculate", "syntax": "CALCulate:LIMit:LOWer {<value>|MINimum|MAXimum}", "description": "Set the lower limit for limit testing.", "example": "CALCulate:LIMit:LOWer 0" },
    { "category": "Calculate", "syntax": "CALCulate:LIMit:LOWer?", "description": "Retrieve the lower limit.", "example": "CALCulate:LIMit:LOWer?" },
    { "category": "Calculate", "syntax": "CALCulate:LIMit:UPPer {<value>|MINimum|MAXimum}", "description": "Set the upper limit for limit testing.", "example": "CALCulate:LIMit:UPPer 5" },
    { "category": "Calculate", "syntax": "CALCulate:LIMit:UPPer?", "description": "Retrieve the upper limit.", "example": "CALCulate:LIMit:UPPer?" },
    { "category": "Calculate", "syntax": "CALCulate:AVERage:MINimum?", "description": "Retrieve the recorded minimum value.", "example": "CALCulate:AVERage:MINimum?" },
    { "category": "Calculate", "syntax": "CALCulate:AVERage:MAXimum?", "description": "Retrieve the recorded maximum value.", "example": "CALCulate:AVERage:MAXimum?" },
    { "category": "Calculate", "syntax": "CALCulate:AVERage:AVERage?", "description": "Retrieve the recorded average value.", "example": "CALCulate:AVERage:AVERage?" },
    { "category": "Calculate", "syntax": "CALCulate:AVERage:COUNt?", "description": "Retrieve how many readings the average was taken over.", "example": "CALCulate:AVERage:COUNt?" },

    { "category": "Display", "syntax": "DISPlay {OFF|ON}", "description": "Turn the display off or on.", "example": "DISPlay ON" },
    { "category": "Display", "syntax": "DISPlay?", "description": "Retrieve the display setting.", "example": "DISPlay?" },
    { "category": "Display", "syntax": "DISPlay:TEXT <quoted string>", "description": "Write a message to the display.", "example": "DISPlay:TEXT \"TESTING\"" },
    { "category": "Display", "syntax": "DISPlay:TEXT?", "description": "Retrieve the displayed message.", "example": "DISPlay:TEXT?" },
    { "category": "Display", "syntax": "DISPlay:TEXT:CLEar", "description": "Clear the message from the display.", "example": "DISPlay:TEXT:CLEar" },

    { "category": "System", "syntax": "SYSTem:ERRor?", "description": "Retrieve the next entry from the meter's error queue.", "example": "SYSTem:ERRor?" },
    { "category": "System", "syntax": "SYSTem:VERSion?", "description": "Retrieve the SCPI version the meter conforms to.", "example": "SYSTem:VERSion?" },
    { "category": "System", "syntax": "SYSTem:LOCal", "description": "Return the meter to local (front-panel) control.", "example": "SYSTem:LOCal" },
    { "category": "System", "syntax": "SYSTem:REMote", "description": "Put the meter into remote mode. Needed for RS-232 operation.", "example": "SYSTem:REMote" },
    { "category": "System", "syntax": "SYSTem:RWLock", "description": "Put the meter into remote mode and lock out the front panel.", "example": "SYSTem:RWLock" },
    { "category": "System", "syntax": "SYSTem:BEEPer", "description": "Issue a single beep.", "example": "SYSTem:BEEPer" },
    { "category": "System", "syntax": "SYSTem:BEEPer:STATe {OFF|ON}", "description": "Disable or enable the beeper for limit and diode testing.", "example": "SYSTem:BEEPer:STATe ON" },
    { "category": "System", "syntax": "SYSTem:BEEPer:STATe?", "description": "Retrieve the state of the beeper.", "example": "SYSTem:BEEPer:STATe?" },
    { "category": "System", "syntax": "SYSTem:DATE <mm/dd/yyyy>", "description": "Set the meter's date.", "example": "SYSTem:DATE 01/31/2026" },
    { "category": "System", "syntax": "SYSTem:DATE?", "description": "Retrieve the meter's date.", "example": "SYSTem:DATE?" },
    { "category": "System", "syntax": "SYSTem:TIME <hh:mm:ss>", "description": "Set the meter's time.", "example": "SYSTem:TIME 13:45:00" },
    { "category": "System", "syntax": "SYSTem:TIME?", "description": "Retrieve the meter's time.", "example": "SYSTem:TIME?" },

    { "category": "Status", "syntax": "STATus:PRESet", "description": "Clear the questionable data enable register.", "example": "STATus:PRESet" },
    { "category": "Status", "syntax": "STATus:QUEStionable:EVENt?", "description": "Retrieve the questionable data event register.", "example": "STATus:QUEStionable:EVENt?" },
    { "category": "Status", "syntax": "STATus:QUEStionable:ENABle <enable value>", "description": "Enable bits in the questionable data enable register.", "example": "STATus:QUEStionable:ENABle 512" },
    { "category": "Status", "syntax": "STATus:QUEStionable:ENABle?", "description": "Retrieve the questionable data enable register.", "example": "STATus:QUEStionable:ENABle?" }
  ]
}
