@* The router. Everything lives under MainLayout; there is no second layout to choose. *@
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <h1>Not here</h1>
            @* /scripts and /capture were addresses once. They are tools belonging to one
               instrument now and open over its console, so anyone arriving on an old link or
               a bookmark is told where they went rather than left on a blank page. *@
            <p class="lede">
                That address does not match a page. Scripts and capture are no longer pages of
                their own: they belong to one instrument, and open from its console on the
                <a href="">bench page</a>.
            </p>
        </LayoutView>
    </NotFound>
</Router>
