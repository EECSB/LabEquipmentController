@page "/sequences"
@implements IAsyncDisposable
@inject BenchClient Bench
@inject IJSRuntime JS

@* No heading and no lede, in either shape. SequenceForm opens on its toolbar and its editor, and
   that is what this opens on too.

   The heading said what the title bar, the browser tab and the status line all say already, and
   the paragraph under it explained the language above the box where the language is written —
   read once, and in the way every time after. What it said is still said where it is needed: on
   the editor's own status line, in Snippets, and in the Script Language Reference. *@

<ScriptEditor IsSequence="true" Script="@_script" ScriptChanged="Typed" Examples="_examples"
              Running="_running" CanRun="@AllBound"
              OnRun="Run" OnStop="Stop"
              Status="@_status" StatusChanged="s => _status = s"
              RecentOutput="@OutputText" OnScriptReplaced="Resolve">
    @* SequenceForm docks this between its toolbar and its editor and keeps it filled: what
       each DEVICE line resolves to, right now. It was behind a Check devices button here,
       which is a press to be told something the window already knows — and a button the
       desktop's toolbar does not have. *@
    @* It was a line of text here and a table in a card below the editor, which is the same three
       facts said twice — the alias, the model it asks for, and what is playing the part. The
       table is the better of the two because it is the only one you can answer: the line
       reported that something was not connected and left you to go and find where to say
       otherwise. So the table is what is docked, and the line went with the card. *@
    <Strip>
        @if (_requirements.Count == 0)
        {
            <p class="devices muted"
               title="A script that names no instruments still runs: PRINT, DELAY and RECORD need none.">@DeviceLine</p>
        }
        else
        {
            <table class="bindings">
                <thead><tr><th>Alias</th><th>Model the script asks for</th><th>Instrument</th></tr></thead>
                <tbody>
                    @foreach (var need in _requirements)
                    {
                        <tr class="@(Bound(need.Alias) is null ? "unbound" : null)">
                            <td class="mono">@need.Alias</td>
                            <td class="mono">@need.Model</td>
                            <td>
                                <select value="@Bound(need.Alias)" @onchange="e => Bind(need.Alias, e.Value?.ToString())"
                                        title="Which open connection plays this part. The script names models, not addresses, so it still finds its instruments after DHCP has moved them.">
                                    <option value="">— not connected —</option>
                                    @foreach (var s in _sessions)
                                    {
                                        <option value="@s.Id">@s.ProfileName — @s.Address</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Strip>
</ScriptEditor>

@* The desktop's lower split: the log on the left and the recorded rows on the right,
   which is how ScriptForm and SequenceForm both arrange them — a script moved between
   the two windows records the same way and should look like it does. It was the output
   alone, with the table and the curve stacked underneath it and only while there were
   rows, so a run you were watching pushed itself off the bottom of the window. *@
<div class="split">
    <div class="group">
        <span class="cap">Output</span>
        <div class="console">
            @foreach (var line in _output)
            {
                <div class="@Css(line.Kind)">@line.Text</div>
            }
        </div>

        <div class="row foot">
            <span class="spacer"></span>
            <button @onclick="ClearLog" disabled="@(_output.Count == 0)"
                    title="Clear the output pane above."><Icon Name="clear" /> Clear Log</button>
            <button @onclick="SaveLog" disabled="@(_output.Count == 0)"
                    title="Save the output pane to a text file — what ran, what came back, and what failed."><Icon Name="save" /> Save Log</button>
        </div>
    </div>

    <ResultsPane Columns="@_columns" Rows="@_rows" OnSaveCsv="SaveCsv" OnClear="ClearResults" />
</div>

@* Docked under the pair, where ScriptForm docks its own: it is the window's status, not
   the editor's, and it reports on running as much as on saving. *@
<div class="row runstatus">
    <span class="muted">@_status</span>
</div>

@code {
    /// <summary>True when hosted in a dialog rather than shown as a page: the dialog’s own
    /// title bar names it, so the heading would be saying it twice.</summary>
    [Parameter] public bool Embedded { get; set; }

    private IReadOnlyList<SessionDto> _sessions = [];
    private IReadOnlyList<ExampleDto> _examples = [];
    private IReadOnlyList<SequenceRequirement> _requirements = [];
    private readonly Dictionary<string, string> _bindings = new(StringComparer.OrdinalIgnoreCase);
    private string _script = "";
    private string _status = "";
    private bool _running;
    private string? _runId;
    private HubConnection? _hub;

    private readonly List<ScriptOutputLine> _output = [];
    private readonly List<RecordedRow> _rows = [];
    private IReadOnlyList<string> _columns = [];

    protected override async Task OnInitializedAsync()
    {
        _examples = await Bench.SequenceExamplesAsync();

        // Open on the first example, as SequenceForm does — `_editor.Text =
        // SequenceExamples.All[0].Script`. A blank editor teaches nothing about a language whose
        // whole point is DEVICE, WITH and FOR, and it leaves "Revise the current script" in the
        // AI window with nothing to revise: the desktop ticks that switch when there is a script,
        // and on the desktop there always is one.
        if (_examples.Count > 0) _script = _examples[0].Script;

        // The bench changes while this page is open — instruments are connected and
        // disconnected from the console — and a strip reporting on a bench that has moved on
        // is worse than no strip. SequenceForm re-reads it on a one-second timer for the same
        // reason; here the client says when, so there is nothing to poll.
        Bench.SessionsChanged += BenchChanged;
        await Resolve();
    }

    private void BenchChanged()
        => _ = InvokeAsync(async () => { await Resolve(); StateHasChanged(); });

    /// <summary>
    /// What was typed, and a re-read of the DEVICE lines once the typing stops.
    ///
    /// SequenceForm re-reads them on every keystroke, because it parses in-process. Here that
    /// is a call to the server, so it waits for a pause rather than firing per character.
    /// </summary>
    private async Task Typed(string text)
    {
        _script = text;

        int mine = ++_edit;
        await Task.Delay(350);
        if (mine != _edit) return;   // more arrived while we waited; that call will do it

        await Resolve();
        StateHasChanged();
    }

    private int _edit;

    private string? Bound(string alias) => _bindings.TryGetValue(alias, out var v) ? v : null;

    /// <summary>
    /// What stands in the strip while the script names no instruments — SequenceForm's own
    /// words for the first of its three states. The other two are the table's now: an alias
    /// with a connection against it, and one with nothing playing the part.
    /// </summary>
    private const string DeviceLine = "No instruments declared \u2014 start with  DEVICE gen : SDG2042X";

    /// <summary>
    /// Whether every DEVICE line has an instrument behind it.
    ///
    /// Vacuously true for a script that declares none, which is what SequenceForm does with Run:
    /// PRINT, DELAY and RECORD need no instrument, and a script carrying a command the runner
    /// will refuse is refused by name, which says more than a greyed-out button.
    /// </summary>
    private bool AllBound => _requirements.All(r => Bound(r.Alias) is not null);

    private void Bind(string alias, string? sessionId)
    {
        if (string.IsNullOrEmpty(sessionId)) _bindings.Remove(alias);
        else _bindings[alias] = sessionId;
    }

    /// <summary>The output as one block, for the AI window's "Include the last run's output".</summary>
    private string OutputText => string.Join('\n', _output.Select(o => o.Text));

    private void ClearLog() => _output.Clear();

    private async Task SaveLog()
    {
        await Download("sequence-output.txt", "text/plain",
            string.Join("\r\n", _output.Select(o => o.Text)));
        _status = "Log saved to sequence-output.txt";
    }

    /// <summary>
    /// Empty the table and the plot. The log is deliberately left alone — it is the record of
    /// how these were produced.
    ///
    /// The headings stay, as ResultsPanel.Clear keeps them: they are what the table is, not what
    /// is in it. A run that wants different ones sets them.
    /// </summary>
    private void ClearResults()
    {
        _rows.Clear();
    }

    private async Task SaveCsv()
    {
        var csv = new System.Text.StringBuilder();
        csv.Append(string.Join(',', _columns)).Append("\r\n");
        foreach (var r in _rows) csv.Append(string.Join(',', r.Values)).Append("\r\n");
        await Download("sequence-results.csv", "text/csv", csv.ToString());
    }

    private async Task Download(string name, string mime, string text)
        => await JS.InvokeVoidAsync("lec.download", name, mime,
            Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text)));

    /// <summary>
    /// Re-read the DEVICE lines and work out what each one resolves to.
    ///
    /// The bench is re-read with them rather than once at startup: this is what the strip says,
    /// and an instrument that has been unplugged since the page opened must stop being named.
    /// </summary>
    private async Task Resolve()
    {
        _sessions = await Bench.SessionsAsync();
        _requirements = await Bench.RequirementsAsync(_script);

        // Pre-bind anything whose model obviously matches a connected instrument; the user
        // can override. Saves the common case of picking three from three.
        foreach (var r in _requirements)
        {
            if (_bindings.ContainsKey(r.Alias)) continue;
            var match = _sessions.FirstOrDefault(s =>
                s.Identity.Contains(r.Model, StringComparison.OrdinalIgnoreCase)
                || s.ProfileName.Contains(r.Model, StringComparison.OrdinalIgnoreCase));
            if (match is not null) _bindings[r.Alias] = match.Id;
        }

        // A binding to an instrument that has gone is not one. Dropping it is what turns the
        // strip red and greys out Run, rather than naming an address nothing is on.
        foreach (string alias in _bindings.Keys.ToList())
            if (!_sessions.Any(s => s.Id == _bindings[alias])) _bindings.Remove(alias);
    }

    private async Task Run()
    {
        _output.Clear();
        _rows.Clear();

        _status = "Running…";
        await Listen();
        var summary = await Bench.RunSequenceAsync(_script, _bindings);
        if (summary.Failed) { _status = "Script failed: " + summary.Error; return; }

        _runId = summary.RunId;
        _columns = summary.Columns;
        _running = true;
        await _hub!.InvokeAsync("Watch", _runId);
    }

    private async Task Stop()
    {
        if (_runId is not null) await Bench.StopAsync(_runId);
    }

    private async Task Listen()
    {
        if (_hub is not null) return;
        _hub = await Bench.HubAsync();
        _hub.On<string, ScriptOutputLine>("RunOutput", (id, line) =>
        {
            if (id != _runId) return;
            _output.Add(line);
            InvokeAsync(StateHasChanged);
        });
        _hub.On<string, RecordedRow>("RunRow", (id, row) =>
        {
            if (id != _runId) return;
            _rows.Add(row);
            InvokeAsync(StateHasChanged);
        });
        _hub.On<string, bool, string?>("RunFinished", (id, failed, error) =>
        {
            if (id != _runId) return;
            _running = false;
            if (error is not null) _output.Add(new ScriptOutputLine(error, "Error"));
            _output.Add(new ScriptOutputLine(failed ? "--- stopped ---" : "--- done ---", "Info"));
            _status = failed ? "Stopped." : "Run complete.";
            InvokeAsync(StateHasChanged);
        });
    }

    private static string Css(string kind) => kind switch
    {
        "Error" => "err",
        "Command" => "echo",
        "Info" => "info",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        Bench.SessionsChanged -= BenchChanged;
        if (_hub is not null && _runId is not null)
            try { await _hub.InvokeAsync("Unwatch", _runId); } catch { /* going away anyway */ }
    }
}
