@page "/sequences"
@implements IAsyncDisposable
@inject BenchClient Bench
@inject IJSRuntime JS
@inject NavigationManager Nav

@* No heading and no lede, in either shape. SequenceForm opens on its toolbar and its editor, and
   that is what this opens on too.

   The heading said what the title bar, the browser tab and the status line all say already, and
   the paragraph under it explained the language above the box where the language is written —
   read once, and in the way every time after. What it said is still said where it is needed: on
   the editor's own status line, in Snippets, and in the Script Language Reference. *@

<ScriptEditor IsSequence="true" Script="@_script" ScriptChanged="Typed" Examples="_examples"
              Running="_running" CanRun="@(AllBound && InputsGiven)"
              OnRun="Run" OnStop="Stop"
              Status="@_status" StatusChanged="s => _status = s"
              RecentOutput="@OutputText" Picks="_picks" OnScriptReplaced="Resolve">
    @* SequenceForm docks this between its toolbar and its editor and keeps it filled: what
       each DEVICE line resolves to, right now. It was behind a Check devices button here,
       which is a press to be told something the window already knows — and a button the
       desktop's toolbar does not have. *@
    @* It was a line of text here and a table in a card below the editor, which is the same three
       facts said twice — the alias, the model it asks for, and what is playing the part. The
       table is the better of the two because it is the only one you can answer: the line
       reported that something was not connected and left you to go and find where to say
       otherwise. So the table is what is docked, and the line went with the card. *@
    <Strip>
        @if (_requirements.Count == 0)
        {
            <p class="devices muted"
               title="A script that names no instruments still runs: PRINT, DELAY and RECORD need none.">@DeviceLine</p>
        }
        else
        {
            <table class="bindings">
                <thead><tr><th>Alias</th><th>Model the script asks for</th><th>Instrument</th></tr></thead>
                <tbody>
                    @foreach (var need in _requirements)
                    {
                        <tr class="@(need.SessionId is null ? "unbound" : null)">
                            <td class="mono">@need.Alias</td>
                            <td class="mono">@need.Model</td>
                            <td>
                                <select value="@need.SessionId" @onchange="e => Bind(need.Alias, e.Value?.ToString())"
                                        title="Which open connection plays this part. The script names models, not addresses, so it still finds its instruments after DHCP has moved them. Two of one model are not guessed between: pick which plays this part.">
                                    @* SequenceForm's "(not connected)" and its two other reasons, said in
                                       the picker: what the part is waiting for, where the answer goes. *@
                                    <option value="">— @(need.Note ?? "not connected") —</option>
                                    @foreach (var s in _sessions)
                                    {
                                        <option value="@s.Id">@s.ProfileName — @s.Address</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* The values the script takes, beside the instruments it takes. Both are things the run
           needs and neither is in the script's text, so both belong in the same strip -- and a
           box that is empty and required greys out Run for the same reason an unbound alias
           does. Parsed here rather than asked of the server: an INPUT line needs no bench to
           read, and it is the same Core parser the server would run. *@
        @if (_inputs.Count > 0)
        {
            <table class="bindings">
                <thead><tr><th>Input</th><th>Value</th><th>What it takes</th></tr></thead>
                <tbody>
                    @foreach (var input in _inputs)
                    {
                        <tr class="@(Filled(input) ? null : "unbound")">
                            <td class="mono">@input.Name</td>
                            <td>
                                <input class="value" value="@Typed(input)"
                                       placeholder="@(input.Default ?? "required")"
                                       @onchange="e => SetInput(input.Name, e.Value?.ToString())"
                                       title="@($"The value {input.Name} has for this run. $" + input.Name + " below stands for it.")" />
                            </td>
                            <td class="muted">@Takes(input)</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (InputProblem is { } problem)
            {
                <p class="devices muted">@problem</p>
            }
        }
    </Strip>
</ScriptEditor>

@* The desktop's lower split: the log on the left and the recorded rows on the right,
   which is how ScriptForm and SequenceForm both arrange them — a script moved between
   the two windows records the same way and should look like it does. It was the output
   alone, with the table and the curve stacked underneath it and only while there were
   rows, so a run you were watching pushed itself off the bottom of the window. *@
<div class="split">
    <div class="group">
        <span class="cap">Output</span>
        <div class="console">
            @foreach (var line in _output)
            {
                <div class="@Css(line.Kind)">@line.Text</div>
            }
        </div>

        <div class="row foot">
            <span class="spacer"></span>
            <button @onclick="ClearLog" disabled="@(_output.Count == 0)"
                    title="Clear the output pane above."><Icon Name="clear" /> Clear Log</button>
            <button @onclick="SaveLog" disabled="@(_output.Count == 0)"
                    title="Save the output pane to a text file — what ran, what came back, and what failed."><Icon Name="save" /> Save Log</button>
        </div>
    </div>

    <ResultsPane Columns="@_columns" Rows="@_rows" OnSaveCsv="SaveCsv" OnClear="ClearResults" />
</div>

@* Docked under the pair, where ScriptForm docks its own: it is the window's status, not
   the editor's, and it reports on running as much as on saving. *@
<div class="row runstatus">
    <span class="muted">@_status</span>
</div>

@code {
    /// <summary>True when hosted in a dialog rather than shown as a page: the dialog’s own
    /// title bar names it, so the heading would be saying it twice.</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>The window this is open in, when it is in one rather than in a tab of its own.</summary>
    [CascadingParameter] public ToolWindow? Window { get; set; }

    /// <summary>
    /// The window coming back from a browser tab that has closed, rather than being opened: what
    /// the tab held comes back with it. WindowDialog says so.
    /// </summary>
    [Parameter] public bool Returning { get; set; }

    private IReadOnlyList<SessionDto> _sessions = [];
    private IReadOnlyList<ExampleDto> _examples = [];
    private IReadOnlyList<SequenceRequirement> _requirements = [];

    /// <summary>
    /// What has been chosen by hand in the table, alias to session id. Every other row is the
    /// server's answer, worked out afresh each time — so a second meter of one model arriving
    /// turns a line that asked for "the" meter red, as it does on the desktop.
    /// </summary>
    private readonly Dictionary<string, string> _picks = new(StringComparer.OrdinalIgnoreCase);

    private string _script = "";
    private string _status = "";
    private bool _running;
    private string? _runId;
    private HubConnection? _hub;

    private readonly List<ScriptOutputLine> _output = [];
    private readonly List<RecordedRow> _rows = [];
    private IReadOnlyList<string> _columns = [];

    protected override async Task OnInitializedAsync()
    {
        if (Window is not null) Window.BeforeClose = MayClose;

        _examples = await Bench.SequenceExamplesAsync();

        // Open on the first example, as SequenceForm does — `_editor.Text =
        // SequenceExamples.All[0].Script`. A blank editor teaches nothing about a language whose
        // whole point is DEVICE, WITH and FOR, and it leaves "Revise the current script" in the
        // AI window with nothing to revise: the desktop ticks that switch when there is a script,
        // and on the desktop there always is one.
        if (_examples.Count > 0) _script = _examples[0].Script;

        // Unless this is the window moved rather than opened, into a tab or back from one: then it
        // opens on what was being written in it.
        if (Moved || Returning) await Unpack();

        // The bench changes while this page is open — instruments are connected and
        // disconnected from the console — and a strip reporting on a bench that has moved on
        // is worse than no strip. SequenceForm re-reads it on a one-second timer for the same
        // reason; here the client says when, so there is nothing to poll.
        Bench.SessionsChanged += BenchChanged;
        await Resolve();
    }

    private void BenchChanged()
        => _ = InvokeAsync(async () => { await Resolve(); StateHasChanged(); });

    /// <summary>
    /// What was typed, and a re-read of the DEVICE lines once the typing stops.
    ///
    /// SequenceForm re-reads them on every keystroke, because it parses in-process. Here that
    /// is a call to the server, so it waits for a pause rather than firing per character.
    /// </summary>
    private async Task Typed(string text)
    {
        _script = text;
        await Keep();

        int mine = ++_edit;
        await Task.Delay(350);
        if (mine != _edit) return;   // more arrived while we waited; that call will do it

        await Resolve();
        StateHasChanged();
    }

    private int _edit;

    /// <summary>
    /// What stands in the strip while the script names no instruments — SequenceForm's own
    /// words for the first of its three states. The other two are the table's now: an alias
    /// with a connection against it, and one with nothing playing the part.
    /// </summary>
    private const string DeviceLine = "No instruments declared — start with  DEVICE gen : SDG2042X";

    /// <summary>
    /// Whether every DEVICE line has an instrument behind it.
    ///
    /// Vacuously true for a script that declares none, which is what SequenceForm does with Run:
    /// PRINT, DELAY and RECORD need no instrument, and a script carrying a command the runner
    /// will refuse is refused by name, which says more than a greyed-out button.
    /// </summary>
    private bool AllBound => _requirements.All(r => r.SessionId is not null);

    /// <summary>The INPUT lines of the script as it stands, in the order they are written.</summary>
    private IReadOnlyList<SequenceInput> _inputs = [];

    /// <summary>
    /// What has been typed for each, by name. Deliberately not kept between visits: a default
    /// lives in the script and comes back with it, and a voltage typed last week silently
    /// reused is the wrong kind of convenience.
    /// </summary>
    private readonly Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Whether every input has a value its own declaration accepts.</summary>
    private bool InputsGiven
        => SequenceRunner.TryBindInputs(_script, _values, out _, out _);

    /// <summary>What is wrong with the values, as a sentence, or null while they are fine.</summary>
    private string? InputProblem
    {
        get
        {
            SequenceRunner.TryBindInputs(_script, _values, out _, out string? why);
            return why;
        }
    }

    /// <summary>What has been typed into one box, or the empty string.</summary>
    private string Typed(SequenceInput input)
        => _values.TryGetValue(input.Name, out string? v) ? v : "";

    /// <summary>True when this input has a value: one typed, or the default it declared.</summary>
    private bool Filled(SequenceInput input)
        => Typed(input).Trim().Length > 0 || !input.Required;

    /// <summary>The declaration in a few words, for the column beside the box.</summary>
    private static string Takes(SequenceInput input)
    {
        var said = new List<string> { input.Kind };

        if (input.Unit.Length > 0) said.Add(input.Unit);

        if (input.Min is { } low && input.Max is { } high) said.Add($"{low:0.##########} to {high:0.##########}");
        else if (input.Min is { } only) said.Add($"{only:0.##########} or more");
        else if (input.Max is { } most) said.Add($"up to {most:0.##########}");

        if (input.Required) said.Add("required");

        return string.Join(", ", said);
    }

    /// <summary>A value typed into one box. An emptied box goes back to the declared default.</summary>
    private void SetInput(string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) _values.Remove(name);
        else _values[name] = value;
    }

    /// <summary>
    /// A choice made in the table, and the table asked again with it.
    ///
    /// Choosing fixes what the table already shows as well: the rows playing a part go on playing
    /// it, rather than the rule handing one row's instrument to another. Picking dmm's meter for
    /// spare too means both of them, not dmm letting go of it.
    /// </summary>
    private async Task Bind(string alias, string? sessionId)
    {
        foreach (var r in _requirements)
            if (r.SessionId is { } id) _picks.TryAdd(r.Alias, id);

        if (string.IsNullOrEmpty(sessionId)) _picks.Remove(alias);
        else _picks[alias] = sessionId;

        await Keep();
        await Resolve();
    }

    // ------------------------------------------------------------ moving into a tab and back

    /// <summary>
    /// This is the window moved into a tab of its own by Open in a tab (WindowCarry). Opened any
    /// other way, a page is a new window, and a new SequenceForm opens on the first example.
    /// </summary>
    private bool Moved => !Embedded && WindowCarry.Moved(Nav);

    /// <summary>Where it is kept on the way, under the address of the page it moves to.</summary>
    private const string Route = "sequences";

    /// <summary>What moves with the window: the script, and the parts picked for it by hand.</summary>
    private sealed record Carried(string Script, Dictionary<string, string> Picks);

    private Carried Pack() => new(_script, new Dictionary<string, string>(_picks));

    /// <summary>
    /// Moving into a tab: leave what this holds where the tab will find it. WindowDialog calls it
    /// as Open in a tab is pressed, before the window closes here. The tab had opened on the first
    /// example, and the script being written went with the dialog.
    /// </summary>
    public async Task SendOutAsync() => await WindowCarry.KeepAsync(JS, Route, Pack());

    /// <summary>In the tab, what it holds is kept current as it changes.</summary>
    private async Task Keep()
    {
        if (Moved) await WindowCarry.KeepAsync(JS, Route, Pack());
    }

    /// <summary>What was carried, into the tab or home from it.</summary>
    private async Task Unpack()
    {
        Carried? carried = await WindowCarry.TakeAsync<Carried>(JS, Route, home: Returning);
        if (carried?.Script is null) return;

        _script = carried.Script;
        foreach (var (alias, id) in carried.Picks ?? []) _picks[alias] = id;
    }

    /// <summary>The output as one block, for the AI window's "Include the last run's output".</summary>
    private string OutputText => string.Join('\n', _output.Select(o => o.Text));

    private void ClearLog() => _output.Clear();

    private async Task SaveLog()
    {
        await Download("sequence-output.txt", "text/plain",
            string.Join("\r\n", _output.Select(o => o.Text)));
        _status = "Log saved to sequence-output.txt";
    }

    /// <summary>
    /// Empty the table and the plot. The log is deliberately left alone — it is the record of
    /// how these were produced.
    ///
    /// The headings stay, as ResultsPanel.Clear keeps them: they are what the table is, not what
    /// is in it. A run that wants different ones sets them.
    /// </summary>
    private void ClearResults()
    {
        _rows.Clear();
    }

    /// <summary>
    /// The recorded rows as a file, through Core's writer — the same one the desktop's
    /// ResultsPanel uses, so a reading with a comma in it is quoted rather than split across
    /// columns. A sequence reads several instruments, so it meets those replies soonest.
    /// </summary>
    private async Task SaveCsv()
        => await Download("sequence-results.csv", "text/csv",
                          CsvWriter.Table(_columns, _rows.Select(r => r.Values)));

    private async Task Download(string name, string mime, string text)
        => await JS.InvokeVoidAsync("lec.download", name, mime,
            Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text)));

    /// <summary>
    /// Re-read the DEVICE lines and work out what each one resolves to.
    ///
    /// The bench is re-read with them rather than once at startup: this is what the strip says,
    /// and an instrument that has been unplugged since the page opened must stop being named.
    /// </summary>
    private async Task Resolve()
    {
        _sessions = await Bench.SessionsAsync();

        // A pick of an instrument that has gone is not one. Dropping it hands the part back to
        // the rule, which finds it another or turns the row red and greys out Run — rather than
        // naming an address nothing is on.
        foreach (string alias in _picks.Keys.ToList())
            if (!_sessions.Any(s => s.Id == _picks[alias])) _picks.Remove(alias);

        // Everything not picked is bound on the server, by the rule SequenceForm's strip is filled
        // by: a model binds only when one instrument answers to it that no other alias has. So
        // the common case of three from three still fills itself, and two of a kind are asked.
        _requirements = await Bench.RequirementsAsync(_script, _picks);

        // And what the script takes from outside. A value typed for an input the script no
        // longer declares is dropped here rather than sent: the server refuses a value nobody
        // declared, and an edit that removes an INPUT line would otherwise make Run stop
        // working with nothing on screen to say why.
        _inputs = SequenceRunner.Inputs(_script);
        foreach (string name in _values.Keys.ToList())
            if (!_inputs.Any(i => i.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                _values.Remove(name);
    }

    /// <summary>
    /// Run it, if every part it names has an instrument. The button comes here, and so does F5.
    /// </summary>
    /// <remarks>
    /// The binding is worked out again at the moment of running, and the run drives exactly what
    /// that says. The button follows the table, and the table is only as new as the last pause
    /// in typing or the last change on the bench, so the button cannot be the check.
    /// SequenceForm checks at this point too. Its F5 once went around a greyed-out Run, and a
    /// DEVICE line with nothing behind it stopped the run only when the run reached it, after a
    /// line above it had already switched a generator's output on.
    ///
    /// And it runs once. F5 held down, or Run pressed twice before the first press has heard
    /// back, is one run. The flag is set before the first await, the way SequenceForm takes its
    /// token.
    /// </remarks>
    private async Task Run()
    {
        if (_running || _starting) return;
        _starting = true;
        Hold();
        try
        {
            await Resolve();
            var bound = _requirements;

            if (bound.FirstOrDefault(r => r.SessionId is null) is { } missing)
            {
                _status = $"Not run — {missing.Alias} → {missing.Model} ({missing.Note ?? "not connected"}).";
                return;
            }

            // Checked here as well as by the button, for the same reason the bindings are: F5
            // comes straight to Run, and a value is as able to stop a script half way as an
            // unbound alias is.
            if (!SequenceRunner.TryBindInputs(_script, _values, out _, out string? badInput))
            {
                _status = "Not run — " + badInput;
                return;
            }

            _output.Clear();
            _rows.Clear();

            _status = "Running…";
            await Listen();

            // Every part as the table shows it, the rule's answers and the picks alike.
            var bindings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var r in bound)
                if (r.SessionId is { } id) bindings.TryAdd(r.Alias, id);
            var summary = await Bench.RunSequenceAsync(_script, bindings, _values);
            if (summary.Failed) { _status = "Script failed: " + summary.Error; return; }

            _runId = summary.RunId;
            _columns = summary.Columns;
            _running = true;
            await _hub!.InvokeAsync("Watch", _runId);
        }
        finally
        {
            _starting = false;
            Hold();
        }
    }

    /// <summary>True from the moment Run is pressed until the run has started or been refused.</summary>
    private bool _starting;

    /// <summary>
    /// Keep the window out of a browser tab while a script runs in it, or is being started. The
    /// script goes with the window, but a run cannot, so it would stay behind with nothing to
    /// watch it or to stop it from. SequenceForm is a window already and has nothing to move.
    /// </summary>
    private void Hold() => Window?.Hold(_running || _starting ? RunHoldsTheWindow : null);

    private const string RunHoldsTheWindow =
        "Not while a script is running in this window. The run cannot move with the window, and "
      + "the tab would open without it. Stop it, or let it finish, first.";

    private async Task Stop()
    {
        if (_runId is not null) await Bench.StopAsync(_runId);
    }

    /// <summary>
    /// Asked before the window shuts, by its ✕ or by Esc: SequenceForm's FormClosing. A script
    /// still running is stopped only if the person says so, because "a half-finished sweep can
    /// leave a generator driving the circuit. Stopping is the caller's decision, not something to
    /// do behind their back." No keeps the window up and the run going. The window had closed
    /// without asking, and the run went on with nothing left to watch it or to stop it from.
    /// </summary>
    private async Task<bool> MayClose()
    {
        // A run being started is a run. SequenceForm takes its token before anything else, so its
        // FormClosing sees one from the first moment. Here the server's answer is waited for.
        while (_starting) await Task.Delay(20);
        if (!_running) return true;

        if (!await JS.InvokeAsync<bool>("confirm", "A script is still running. Stop it and close?"))
            return false;
        await Stop();
        return true;
    }

    private async Task Listen()
    {
        if (_hub is not null) return;
        _hub = await Bench.HubAsync();
        _hub.On<string, ScriptOutputLine>("RunOutput", (id, line) =>
        {
            if (id != _runId) return;
            _output.Add(line);
            InvokeAsync(StateHasChanged);
        });
        _hub.On<string, RecordedRow>("RunRow", (id, row) =>
        {
            if (id != _runId) return;
            _rows.Add(row);
            InvokeAsync(StateHasChanged);
        });
        _hub.On<string, bool, string?>("RunFinished", (id, failed, error) =>
        {
            if (id != _runId) return;
            _running = false;
            Hold();
            if (error is not null) _output.Add(new ScriptOutputLine(error, "Error"));
            _output.Add(new ScriptOutputLine(failed ? "--- stopped ---" : "--- done ---", "Info"));
            _status = failed ? "Stopped." : "Run complete.";
            InvokeAsync(StateHasChanged);
        });
    }

    private static string Css(string kind) => kind switch
    {
        "Error" => "err",
        "Command" => "echo",
        "Info" => "info",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        Bench.SessionsChanged -= BenchChanged;
        if (_hub is not null && _runId is not null)
            try { await _hub.InvokeAsync("Unwatch", _runId); } catch { /* going away anyway */ }
    }
}
