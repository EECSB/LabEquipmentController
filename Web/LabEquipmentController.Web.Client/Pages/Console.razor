@page "/console"
@inject BenchClient Bench
@inject IJSRuntime JS
@inject NavigationManager Nav

@* One console in a window of its own — the web's answer to the desktop's InstrumentWindow.

   Consoles otherwise live in tabs on the bench page, so this route exists for the detached
   ones: opened by name, so a second Detach comes back to this window instead of opening a
   third, and titled after the instrument so the browser's tab strip says which is which.
   Reached without detached=1 it hands straight back to the bench page, which is where an
   attached console belongs and where its log already is. *@

@if (_session is null)
{
    <div class="group">
        <span class="cap">Console</span>
        <p class="muted" style="margin:0">
            @(_loaded
                ? "That instrument is not connected any more — it may have been closed from the bench page."
                : "Looking for that instrument…")
        </p>
        <p style="margin:.6rem 0 0"><a href="">Back to the bench</a></p>
    </div>
}
else
{
    <ConsoleView @ref="_console" Session="_session" Detached="true"
                 OnReattach="Reattach" OnOpenTool="OpenTool" />

    @* Beside the console rather than inside it, as on the bench page. Nothing hides a console
       in a window of its own, but the console is one component in both places and the windows
       are the page’s in both. *@
    <ConsoleTools @ref="_tools" Session="_session" OnInsert="Insert" />
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "session")]
    public string? SessionFromQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "detached")]
    public string? DetachedFromQuery { get; set; }

    private SessionDto? _session;
    private ConsoleView? _console;
    private ConsoleTools? _tools;
    private bool _loaded;
    private bool _claimed;

    protected override async Task OnInitializedAsync()
    {
        // An attached console is a tab on the bench page. Sending it there keeps one home for
        // it rather than two half-equal ones, and carries the selection along in the address.
        if (DetachedFromQuery != "1")
        {
            Nav.NavigateTo(SessionFromQuery is null ? "" : $"?session={SessionFromQuery}", replace: true);
            return;
        }

        var sessions = await Bench.SessionsAsync();
        _session = sessions.FirstOrDefault(s => s.Id == SessionFromQuery);
        _loaded = true;
    }

    /// <summary>
    /// Announce this console to the bench page, which dims its tab while the window is open,
    /// and title the browser tab after the instrument. Undone automatically when this window
    /// closes, however it closes.
    /// </summary>
    /// <remarks>
    /// Not on the first render: the first render happens before the session has been fetched,
    /// so there is nothing to announce yet. On the first render that has one — after which
    /// there is nothing more to say.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_claimed || _session is null) return;
        _claimed = true;
        await JS.InvokeVoidAsync("lec.windows.claim", _session.Id,
                                 $"{_session.ProfileName} — Lab Equipment Controller");
    }

    private async Task Reattach() => await JS.InvokeVoidAsync("lec.windows.release");

    /// <summary>A tool button in the console. The windows are the page’s - see ConsoleTools.</summary>
    private async Task OpenTool(ConsoleTool tool)
    {
        if (_tools is not null) await _tools.OpenAsync(tool);
    }

    /// <summary>A command chosen in the Command Reference, on its way to the command box.</summary>
    private void Insert(string command) => _console?.Insert(command);
}
