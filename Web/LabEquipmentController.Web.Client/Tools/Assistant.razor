@implements IAsyncDisposable
@inject WebAiService Ai
@inject AssistantState Main
@inject ScriptChats Scripts
@inject BenchClient Bench
@inject ScriptHandoff Handoff
@inject IJSRuntime JS
@inject AiPreferences Preferences

@* The web's AI windows (SPEC §11d): GDS Viewer's window (its Components/AskAi.razor, the same .ai*
   classes, wwwroot/assistant.css) over this bench's conversation (UI-SPEC §5, The AI assistant).

   The AI assistant, under the gear: a conversation with a model that works the bench through the
   tools in BenchToolRunner. Reads run as it asks, a send waits on its card for Approve on the middle
   rung, and a script is only ever put forward, with a Use This Script of its own that puts it in an
   editor where only Run runs it.

   Write a Script with AI, with Writer set, opened from a script editor: the same window, its chats,
   its files, its box and its meter, asking the server's script writer, which has the catalogs,
   rather than a model with tools. One window so the two cannot come to differ.

   The conversation and everything the window holds between openings is AiWindowState, a scoped
   service: a tool window is taken out of the page when it shuts, so what it holds lives there, an
   answer still coming included. Everything it stands on (the connections, the relay, the server's
   kept chats) is WebAiService. *@

@* The writer's 1320×920 is the size the desktop's writer had on a 175% screen (754×526 logical), kept so that
   everything in the window is in view when it opens (UI-SPEC §9, Known differences). *@
<ToolWindow @ref="_window" Title="@(Writer is null ? "AI assistant" : "Write a Script with AI")" Subtitle="@AssistantPrompt.BenchLine(_benchNow)" Fill="true"
            OpenWidth="@(Writer is null ? 1100 : 1320)" OpenHeight="@(Writer is null ? 860 : 920)" OnClosed="Closed">
    <TitleIcon>
        <svg viewBox="0 0 16 16" width="15" height="15">
            <path fill="currentColor" d="M6.4 1.6c.3 2.6 1.6 4 4.2 4.3-2.6.3-3.9 1.7-4.2 4.3-.3-2.6-1.6-4-4.2-4.3 2.6-.3 3.9-1.7 4.2-4.3z" />
            <path fill="currentColor" d="M11.6 8.6c.2 1.6 1 2.4 2.6 2.6-1.6.2-2.4 1-2.6 2.6-.2-1.6-1-2.4-2.6-2.6 1.6-.2 2.4-1 2.6-2.6z" />
        </svg>
    </TitleIcon>
    <ChildContent>
        @{
            IReadOnlyList<ChatTurn> turns = State.Chat.Turns;
            int folded = Math.Min(State.Chat.FoldedBefore, turns.Count);
            List<SlashCommand> listed = SlashShown();
        }
        <div class="aiBody" @ref="_zone">
            <div class="aiChatRow aiDrop" @ref="_row">

                @* ------------------------------------------------------------ the kept chats *@
                @if (State.ChatsOpen)
                {
                    <aside id="aiChats" class="aiChats" aria-label="Chats">
                        <div class="aiPanelTop">
                            <button id="aiChatsNew" type="button" class="aiChatsNew" @onclick="NewChat" disabled="@(Busy || turns.Count == 0)"
                                    title="@(Busy ? WhyBusy : "A new chat. This one stays in the chats list, to open again.")">
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                </svg>
                                New chat
                            </button>

                            <button id="aiChatsClose" type="button" class="aiPanelClose" aria-label="Close the chats" title="Close the chats" @onclick="() => State.ChatsOpen = false">
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                </svg>
                            </button>
                        </div>

                        <div class="aiChatsHead">Chats</div>

                        @* The chat on screen before it is kept: the first row, as it will be once its first answer is in. *@
                        @if (State.ChatId is null)
                        {
                            <div id="aiChatNow" class="aiChatItem aiChatItemOn" aria-current="true" title="The chat on screen, kept here from its first question.">
                                <span class="aiChatText">
                                    <span class="aiChatTitle">@SavedChat.TitleFor(turns)</span>
                                    <span class="aiChatWhen">Not kept yet</span>
                                </span>
                            </div>
                        }

                        @foreach (ChatSummary chat in _chatList)
                        {
                            bool current = chat.Id == State.ChatId;

                            if (_confirmingDelete == chat.Id)
                            {
                                <div class="aiChatItem aiChatItemDeleting" data-chat="@chat.Id" @key="chat.Id">
                                    <span class="aiChatAsk">Delete this chat?</span>
                                    <span class="aiChatAskButtons">
                                        <button type="button" class="aiChatDeleteYes" @onclick="() => DeleteChatAsync(chat.Id)">Delete</button>
                                        <button type="button" class="aiChatDeleteNo" @onclick="() => _confirmingDelete = null">Keep</button>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="aiChatItem @(current ? "aiChatItemOn" : null) @(Busy && !current ? "aiChatItemOff" : null)" data-chat="@chat.Id" @key="chat.Id"
                                     role="button" tabindex="0" aria-current="@(current ? "true" : "false")"
                                     title="@(Busy && !current ? WhyBusy : current ? "The chat on screen." : $"Open it and carry on: {chat.Title}")"
                                     @onclick="() => OpenChatAsync(chat.Id)" @onkeydown="e => ChatRowKey(e, chat.Id)">
                                    <span class="aiChatText">
                                        <span class="aiChatTitle">@chat.Title</span>
                                        <span class="aiChatWhen">@(chat.Bench.Length > 0 ? chat.Bench + " · " : "")@When(chat.Updated)</span>
                                    </span>

                                    <button type="button" class="aiChatButton aiChatExport" aria-label="Save as text" disabled="@(current && Busy)"
                                            title="Save this chat as text: every question, answer and call, and what each answer was billed."
                                            @onclick="() => ExportAsync(chat.Id)" @onclick:stopPropagation="true">
                                        <svg viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill="currentColor" d="M8 1.5a.5.5 0 0 1 .5.5v7.79l2.65-2.64a.5.5 0 0 1 .7.7l-3.5 3.5a.5.5 0 0 1-.7 0l-3.5-3.5a.5.5 0 1 1 .7-.7L7.5 9.79V2a.5.5 0 0 1 .5-.5" />
                                            <path fill="currentColor" d="M2.5 10.5a.5.5 0 0 1 .5.5v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-2a.5.5 0 0 1 1 0v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2a.5.5 0 0 1 .5-.5" />
                                        </svg>
                                    </button>

                                    <button type="button" class="aiChatButton aiChatDelete" aria-label="Delete" disabled="@(current && Busy)"
                                            title="Delete this chat. It asks first, here in the row."
                                            @onclick="() => _confirmingDelete = chat.Id" @onclick:stopPropagation="true">
                                        <svg viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill="currentColor" d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                            <path fill="currentColor" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        }

                        <div class="aiChatsKept">Kept @Ai.KeptWhere</div>
                    </aside>

                    <div class="aiSplit" data-split="chats" title="Drag to size the chats"></div>
                }
                else
                {
                    <button id="aiChatsToggle" type="button" class="aiSplitToggle aiSplitToggleLeft" aria-expanded="false"
                            aria-label="Open the chats" title="Open the chats, kept @Ai.KeptWhere: open one to carry it on, save it as text, or delete it." @onclick="() => State.ChatsOpen = true">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M5.75 3.5 10.25 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                }

                @* ------------------------------------------------------------ the conversation *@
                <div id="aiTranscript" class="aiTranscript" @ref="_transcript">
                    @if (turns.Count == 0)
                    {
                        <div class="aiIntro">
                            @if (Writer is null)
                            {
                                <p>
                                    Ask about the bench, or have the assistant work it: it reads the instruments with the bench's own
                                    tools, and can write a script for you to run. Attach a datasheet or a screenshot, or type / for the
                                    window's commands.
                                </p>

                                <div id="aiExamples" class="aiExamples" aria-label="Examples to start from">
                                    @foreach (string example in Examples)
                                    {
                                        <button type="button" class="aiExample" title="Put this in the box, to send or change first" @onclick="() => UseExample(example)">@example</button>
                                    }
                                </div>

                                <p id="aiContext" class="@(_benchNow.Count == 0 ? "aiIntroWarning" : null)">@AssistantPrompt.Context(_benchNow)</p>

                                <p>
                                    What you type, and what the assistant reads from the instruments, pictures of their screens
                                    included, is sent to the provider of the model picked below. Nothing is sent until you press Send.
                                </p>
                            }
                            else
                            {
                                @if (_sessions.Count == 0)
                                {
                                    <p id="aiContext" class="aiIntroWarning">
                                        No instrument is connected, so there is no command catalog to write against.
                                        Connect one first, otherwise the script can only be guesswork.
                                    </p>
                                }
                                else
                                {
                                    <p id="aiContext">
                                        The model is given the command catalogs @(Writer.IsSequence ? "ticked under the sliders in the box" : "below") and told to use
                                        nothing else. Check what it writes before you run it. Attach a photo of the wiring, a datasheet or a
                                        screenshot, or type / for the window's commands.
                                    </p>

                                    @if (!Writer.IsSequence)
                                    {
                                        <ul class="bullets">
                                            @foreach (SessionDto s in _sessions.Where(s => Chosen().Contains(s.Id)))
                                            {
                                                <li>@Catalogued(s)</li>
                                            }
                                        </ul>
                                    }
                                }

                                <div id="aiExamples" class="aiExamples" aria-label="An example to start from">
                                    <button type="button" class="aiExample" title="Put this in the box, to send or change first" @onclick="() => UseExample(WriterExample)">@WriterExample</button>
                                </div>

                                <p>
                                    What comes back appears here, and each new request is asked with everything above it, so a
                                    follow-up like &ldquo;now do the same at 5&nbsp;V&rdquo; means something.
                                </p>
                            }

                            @if (_book.Items.Count == 0)
                            {
                                <p id="aiNoModel" class="aiIntroWarning">
                                    There is no model yet. Add one, with your own key, under
                                    <button id="aiOpenSettings" type="button" class="aiLink" @onclick="() => Ai.AskForSettingsAsync()">AI settings</button>.
                                </p>
                            }
                        </div>
                    }

                    @* What a compaction folded away is still here, before its briefing: shown when asked, dimmed. *@
                    @for (int i = 0; i < turns.Count; i++)
                    {
                        ChatTurn turn = turns[i];
                        int index = i;
                        string? fold = FoldClass(index, folded);

                        @if (turn.Kind == ChatTurn.User)
                        {
                            <div class="aiTurn aiTurnUser @fold" @key="turn">
                                <div class="aiQuestion">
                                    @* The files it was sent with, over its words: struck through once unticked in the files panel. *@
                                    @if (turn.Attachments.Count > 0)
                                    {
                                        <div class="aiChips aiQuestionFiles">
                                            @foreach (AiAttachment file in turn.Attachments)
                                            {
                                                <span class="aiChip @(file.Excluded ? "aiChipOff" : null)" title="@SentChipTitle(file)">@file.Name</span>
                                            }
                                        </div>
                                    }
                                    <div class="aiBubble aiBubbleUser">@turn.Text</div>
                                </div>
                            </div>
                        }
                        else if (turn.Kind == ChatTurn.Assistant)
                        {
                            WrittenScript? written = Writer is null ? null : WrittenScript.Read(turn.Text);

                            @if (written is not null)
                            {
                                <div class="aiCard aiCardRead @fold" @key="turn">
                                    <div class="aiCardTitle">Proposed a script</div>

                                    <pre class="aiCode aiCodeScript">@written.Script</pre>

                                    @* Under the script it takes, in the answer it belongs to. One at the foot of the window could
                                       only ever mean the newest, which in a conversation is the wrong one as often as it is the right one. *@
                                    <div class="aiCardButtons">
                                        <button type="button" class="aiAct aiUseScript" @onclick="() => OnUse.InvokeAsync(written.Script)"
                                                title="Put this script into the editor. It is not run: you still decide that.">Use This Script</button>
                                    </div>

                                    @* The catalog check first, the model's own account second. What must be read is what the
                                       catalog says, not what the thing being checked says about itself. *@
                                    @if (written.Undocumented.Count > 0)
                                    {
                                        <div class="aiCardNote aiFormError aiCheck">
                                            &#9888; @written.Undocumented.Count line(s) use commands that are in no
                                            catalog here. Check them against the instrument's guide before
                                            running: @string.Join(", ", written.Undocumented.Take(8))@(written.Undocumented.Count > 8 ? ", …" : "")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="aiCardNote aiCheck">
                                            Every command header here is in the catalog. The values after them
                                            were not checked: read the script before you run it.
                                        </div>
                                    }
                                </div>

                                @if (written.Notes.Length > 0)
                                {
                                    <div class="aiTurn @fold">
                                        <div class="aiBubble aiBubbleAssistant">@written.Notes</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="aiTurn @fold" @key="turn">
                                    <div class="aiBubble aiBubbleAssistant">@turn.Text</div>
                                </div>
                            }

                            @if (turn.Usage is not null)
                            {
                                <div class="aiUsage @fold" title="@UsageTitle(turn)">@AiChat.UsageLine(turn)</div>
                            }
                        }
                        else if (turn.Kind == ChatTurn.Summary)
                        {
                            <div class="aiSummary @fold" @key="turn">
                                <div class="aiSummaryHead">
                                    <span class="aiSummaryTitle">Conversation compacted</span>
                                    @if (index == folded && folded > 0)
                                    {
                                        <button id="aiShowEarlier" type="button" class="aiLink" @onclick="() => State.ShowFolded = !State.ShowFolded">@(State.ShowFolded ? "Hide what came before" : $"Show what came before ({folded})")</button>
                                    }
                                </div>
                                <div class="aiSummaryNote">The assistant carries on from this briefing. What came before it is not sent again.</div>
                                <div class="aiSummaryText">@turn.Text</div>
                                @if (turn.Attachments.Count > 0)
                                {
                                    <div class="aiSummaryNote aiSummaryFiles">
                                        Its files are kept, unticked: @string.Join(", ", turn.Attachments.Select(a => a.Name)).
                                        <button type="button" class="aiLink" @onclick="() => State.FilesOpen = true">Tick one in the files panel</button> to send it again.
                                    </div>
                                }
                            </div>
                            @if (turn.Usage is not null)
                            {
                                <div class="aiUsage @fold" title="@UsageTitle(turn)">@AiChat.UsageLine(turn)</div>
                            }
                        }
                        else if (turn.Kind == ChatTurn.Tool)
                        {
                            bool waiting = AssistantPrompt.Waiting(turn);
                            <div class="aiCard @(turn.Changes ? "aiCardChange" : "aiCardRead") @fold" data-tool="@turn.ToolName" @key="turn">
                                <div class="aiCardTitle">
                                    @CardTitle(turn)
                                    @if (turn.Auto)
                                    {
                                        <span class="aiBadge" title="Run without asking, because of the setting below">auto</span>
                                    }
                                </div>

                                <pre class="aiCode">@CallShown(turn)</pre>

                                @if (waiting)
                                {
                                    <div class="aiCardButtons">
                                        <button type="button" class="aiAct aiApprove" @onclick="() => State.Chat.Decide(turn, true)">@(turn.Changes ? "Approve and Send" : "Approve")</button>
                                        <button type="button" class="aiAct aiDecline" @onclick="() => State.Chat.Decide(turn, false)">Decline</button>
                                    </div>
                                }
                                else if (turn.Decision == false)
                                {
                                    <div class="aiCardNote">Declined. The assistant was told it was not done.</div>
                                }
                                else if (turn.Result is null)
                                {
                                    @if (turn.Decision == true)
                                    {
                                        <div class="aiCardNote">Running…</div>
                                    }
                                }
                                else
                                {
                                    <div class="aiCardNote">@(turn.ResultIsError ? "Refused. The assistant was told why:" : "Done. The assistant was told:")</div>
                                    <pre class="aiCode @(turn.ResultIsError ? "aiCodeRefused" : null)">@turn.Result</pre>

                                    @if (turn.Png is string png)
                                    {
                                        <img class="aiPicture" src="data:image/png;base64,@png" alt="The instrument's screen, as the model was shown it." />
                                    }

                                    @if (turn.Proposal is string script)
                                    {
                                        <pre class="aiCode aiCodeScript">@script</pre>
                                        <div class="aiCardButtons">
                                            <button type="button" class="aiAct aiUseScript" @onclick="() => UseScriptAsync(turn)"
                                                    title="Put it in the script editor, to read and run there. Nothing runs until you press Run.">Use This Script</button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else if (turn.Kind == ChatTurn.Note || turn.Kind == ChatTurn.Reopened)
                        {
                            <div class="aiTurnNote @fold" @key="turn">@turn.Text</div>
                        }
                        else if (turn.Kind == ChatTurn.Paused)
                        {
                            <div class="aiTurnPaused @fold" @key="turn">
                                <span>@turn.Text</span>
                                @if (index == turns.Count - 1 && !Busy)
                                {
                                    <button id="aiContinue" type="button" class="aiAct aiContinueButton" @onclick="() => SendAsync(ContinueWord, fromBox: false)"
                                            title="Carry on for as many rounds again. Each round sends the conversation again.">Continue</button>
                                }
                            </div>
                            @if (turn.Usage is not null)
                            {
                                <div class="aiUsage @fold" title="@UsageTitle(turn)">@AiChat.UsageLine(turn)</div>
                            }
                        }
                        else
                        {
                            <div class="aiTurnError @fold" @key="turn">@turn.Text</div>
                            @* A run that failed or was stopped partway was still billed for what it sent. *@
                            @if (turn.Usage is not null)
                            {
                                <div class="aiUsage @fold" title="@UsageTitle(turn)">@AiChat.UsageLine(turn)</div>
                            }
                        }
                    }

                    @if (State.Chat.Compacting)
                    {
                        <div id="aiThinking" class="aiThinking">Compacting the conversation…</div>
                    }
                    else if (Busy)
                    {
                        <div id="aiThinking" class="aiThinking">Thinking…</div>
                    }
                </div>

                @* The slash commands: over the conversation's foot, just above the box, narrowed as the name is typed. *@
                @if (listed.Count > 0)
                {
                    <div id="aiSlashMenu" class="aiSlashMenu" role="listbox" aria-label="Commands">
                        @for (int i = 0; i < listed.Count; i++)
                        {
                            SlashCommand command = listed[i];
                            int position = i;
                            <div class="aiSlashItem @(position == Marked(listed) ? "aiSlashItemOn" : null) @(command.WhyNot is null ? null : "aiSlashItemOff")"
                                 role="option" aria-selected="@(position == Marked(listed) ? "true" : "false")" data-command="@command.Name"
                                 title="@(command.WhyNot ?? command.What)"
                                 @onmouseenter="() => _slashMarked = position" @onmousedown:preventDefault="true" @onclick="() => RunSlashAsync(command, string.Empty)">
                                <span class="aiSlashName">@command.Name</span>
                                <span class="aiSlashSays">@(command.WhyNot ?? command.What)</span>
                            </div>
                        }
                    </div>
                }

                @* ------------------------------------------------------------ the conversation's files *@
                @if (State.FilesOpen)
                {
                    List<(ChatTurn Question, AiAttachment File)> sent = State.Chat.SentFiles();
                    List<(ChatTurn Question, AiAttachment File)> asked = [.. sent.Where(s => s.Question.Kind != ChatTurn.Summary)];
                    List<(ChatTurn Question, AiAttachment File)> briefed = [.. sent.Where(s => s.Question.Kind == ChatTurn.Summary)];

                    <div class="aiSplit" data-split="files" title="Drag to size the files"></div>

                    <aside id="aiFiles" class="aiFiles" aria-label="Files in this conversation">
                        <div class="aiPanelTop">
                            <div class="aiFilesHead">In this conversation</div>
                            <button id="aiFilesClose" type="button" class="aiPanelClose" aria-label="Close the files" title="Close the files" @onclick="() => State.FilesOpen = false">
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                </svg>
                            </button>
                        </div>

                        @if (asked.Count == 0)
                        {
                            <div class="aiFilesNone">@(briefed.Count > 0 ? "None sent since it was compacted." : "None sent yet.")</div>
                        }

                        @foreach (var (question, file) in asked)
                        {
                            <label class="aiFileRow @(file.Excluded ? "aiFileOff" : null)" title="Sent with: @Cut(question.Text, 160)" @key="(file, file.Excluded, _filesDrawn)">
                                <input type="checkbox" class="aiFileTick" checked="@(!file.Excluded)" disabled="@Busy" @onchange="e => Include(file, e.Value is true)"
                                       aria-label="Send @file.Name with every question" />
                                <span class="aiFileName">@file.Name</span>
                                <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                            </label>
                        }

                        @if (briefed.Count > 0)
                        {
                            <div class="aiFilesHead">From before the summary</div>
                            @foreach (var (_, file) in briefed)
                            {
                                <label class="aiFileRow @(file.Excluded ? "aiFileOff" : null)" title="Read into the summary when the conversation was compacted. Tick it to send it again with every question." @key="(file, file.Excluded, _filesDrawn)">
                                    <input type="checkbox" class="aiFileTick" checked="@(!file.Excluded)" disabled="@Busy" @onchange="e => Include(file, e.Value is true)"
                                           aria-label="Send @file.Name with every question" />
                                    <span class="aiFileName">@file.Name</span>
                                    <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                                </label>
                            }
                        }

                        <div class="aiFilesHead">With the next question</div>

                        @if (State.Chat.Pending.Count == 0)
                        {
                            <div class="aiFilesNone">None. Attach one with the paperclip, paste a picture into the box, or drop files here.</div>
                        }

                        @foreach (AiAttachment file in State.Chat.Pending)
                        {
                            <div class="aiFileRow">
                                <span class="aiFileName" title="@file.Name">@file.Name</span>
                                <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                                <button type="button" class="aiChipRemove" aria-label="Take @file.Name off" title="Take it off" @onclick="() => Unattach(file)">&times;</button>
                            </div>
                        }

                        @if (_filesProblem.Length > 0)
                        {
                            <div class="aiFormError">@_filesProblem</div>
                        }

                        <div id="aiFilesWeight" class="aiFilesWeight">@FilesWeight(sent)</div>
                    </aside>
                }
                else
                {
                    int count = State.Chat.SentFiles().Count + State.Chat.Pending.Count;
                    <button id="aiFilesToggle" type="button" class="aiSplitToggle aiSplitToggleRight" aria-expanded="false"
                            aria-label="Open the files" title="Open the files in this conversation, and which of them go with every question." @onclick="() => State.FilesOpen = true">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M10.25 3.5 5.75 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        @if (count > 0)
                        {
                            <span id="aiFilesCount" class="aiFilesCount">@count</span>
                        }
                    </button>
                }
            </div>

            @* The suggestion to compact, priced: what the history costs every question now, and what compacting it costs once. *@
            @if (WorthCompacting())
            {
                <div id="aiCompactSuggestion" class="aiSuggest">
                    <span class="aiSuggestText">@CompactSuggestion()</span>
                    <button id="aiCompactNow" type="button" class="aiAct" @onclick="CompactAsync"
                            title="Put a briefing in place of the conversation so far. What it stands in for stays on screen, and is not sent again.">Compact</button>
                    <button id="aiCompactLater" type="button" class="aiLink" @onclick="() => State.Chat.CompactSuggestionDismissed = true">Not now</button>
                </div>
            }

            @* The files waiting to go with the next question, each with its cross. *@
            @if (State.Chat.Pending.Count > 0)
            {
                <div id="aiPending" class="aiChips">
                    @foreach (AiAttachment file in State.Chat.Pending)
                    {
                        <span class="aiChip @(NotSentTo(file) is null ? null : "aiChipBlocked")" title="@PendingChipTitle(file)">
                            <span class="aiChipName">@file.Name</span>
                            <span class="aiChipSize">@AiAttachment.Size(file.Data.Length)</span>
                            <button type="button" class="aiChipRemove" aria-label="Take @file.Name off" title="Take it off" @onclick="() => Unattach(file)">&times;</button>
                        </span>
                    }
                </div>
            }

            @if (_attachProblem.Length > 0)
            {
                <div id="aiAttachProblem" class="aiFormError">@_attachProblem</div>
            }

            @if (State.Notice.Length > 0)
            {
                <div id="aiNotice" class="aiFormWarning">@State.Notice</div>
            }

            @if (_speechProblem.Length > 0)
            {
                <div id="aiSpeechProblem" class="aiFormError">@_speechProblem</div>
            }

            @* The camera, live, over the box: the shutter attaches the frame on screen to the next question, and the card goes. *@
            @if (_cameraOpen)
            {
                <div id="aiCamera" class="aiCamera" role="dialog" aria-label="Camera" data-popup @ref="_cameraCard">
                    <video id="aiCameraVideo" class="aiCameraVideo" @ref="_cameraVideo" autoplay playsinline muted></video>

                    <button id="aiCameraClose" type="button" class="aiBarButton aiCameraClose" aria-label="Close the camera" title="Close the camera" @onclick="CloseCameraAsync">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </button>

                    <div class="aiCameraRow">
                        @if (_cameraProblem.Length > 0)
                        {
                            <span id="aiCameraProblem" class="aiFormError">@_cameraProblem</span>
                        }
                        else
                        {
                            <button id="aiCameraCapture" type="button" class="aiCameraShutter" aria-label="Capture"
                                    title="Take the picture on screen, and attach it to the next question" @onclick="CaptureAsync">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 5.2a1.2 1.2 0 0 1 1.2-1.2h1.9l1.1-1.6h3.6l1.1 1.6h1.9A1.2 1.2 0 0 1 14 5.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2A1.2 1.2 0 0 1 2 11.8z" />
                                    <circle cx="8" cy="8.4" r="2.5" />
                                </svg>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!Busy && WhyNotSend() is string cannot)
            {
                <div id="aiCannotSend" class="aiFormWarning">@cannot</div>
            }

            @* The box and what goes with the next question, in one rounded frame: the words on top, and
               along the frame's foot a slim row of borderless controls. A press anywhere in the frame's
               spare room puts the caret in the box. *@
            <div class="aiBox @(_listening ? "aiBoxListening" : null)" @onclick="FocusBoxAsync">
                <textarea id="aiPrompt" class="aiField aiPrompt" rows="1" @ref="_box" @bind="State.Draft" @bind:event="oninput" @bind:after="Typed"
                          data-slash-menu="@(listed.Count > 0 ? "open" : "closed")"
                          placeholder="@(Writer is null ? "Ask about the bench, or type / for commands" : "Say what the script should do, or type / for commands")"
                          title="@(Writer is null
                                    ? "Enter sends, Shift+Enter starts a new line. A picture pasted here goes with the question."
                                    : "Plain English. Say what you want measured or set, and at what values: the more specific, the less the model has to guess. Enter sends it, Shift+Enter starts a new line. A picture pasted here goes with the request.")"
                          aria-label="@(Writer is null ? "Ask the assistant" : "What the script should do")"></textarea>

                @* What the microphone hears, in the box's top right corner so nothing in the row moves. *@
                @if (_listening)
                {
                    <span id="aiMicLevel" class="aiMicLevel" @ref="_micLevel" aria-hidden="true" title="What the microphone hears">
                        @for (int bar = 0; bar < MicLevelBars; bar++)
                        {
                            <span class="aiMicLevelBar"></span>
                        }
                    </span>
                }

                <div class="aiBoxBar">
                    <InputFile @ref="_input" OnChange="AttachAsync" multiple class="aiFileInput" accept="@AiAttachment.Accept" tabindex="-1" aria-hidden="true" />

                    <button id="aiAttach" type="button" class="aiBarButton aiAttach" aria-label="Attach files"
                            title="Attach files to the next question: pictures, PDFs, Excel and Word files and text files, up to @AiAttachment.MostPerQuestion. A picture pasted into the box, or files dropped on the window, go the same way."
                            @onclick="PickFilesAsync" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path fill="currentColor" d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0z" />
                        </svg>
                    </button>

                    <button id="aiCameraToggle" type="button" class="aiBarButton aiCameraToggle @(_cameraOpen ? "aiBarButtonOn" : null)"
                            aria-pressed="@(_cameraOpen ? "true" : "false")" aria-label="Take a picture with the camera"
                            title="Take a picture with your camera, and attach it to the next question as a pasted picture is, for a model that sees pictures."
                            @onclick="ToggleCameraAsync" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 5.2a1.2 1.2 0 0 1 1.2-1.2h1.9l1.1-1.6h3.6l1.1 1.6h1.9A1.2 1.2 0 0 1 14 5.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2A1.2 1.2 0 0 1 2 11.8z" />
                            <circle cx="8" cy="8.4" r="2.5" />
                        </svg>
                    </button>

                    <button id="aiScreenshot" type="button" class="aiBarButton aiScreenshot" aria-label="Attach a screenshot"
                            title="Take a screenshot of a screen, a window or a browser tab, picked in your browser's own window, and attach it to the next question, for a model that sees pictures."
                            @onclick="ScreenshotAsync" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 5V3.2A1.2 1.2 0 0 1 3.2 2H5M11 2h1.8A1.2 1.2 0 0 1 14 3.2V5M14 11v1.8a1.2 1.2 0 0 1-1.2 1.2H11M5 14H3.2A1.2 1.2 0 0 1 2 12.8V11" />
                            <rect x="5" y="5.5" width="6" height="5" rx="0.8" />
                        </svg>
                    </button>

                    @if (Writer is null)
                    {
                        @* How far the model may go on its own. On the middle rung at every start and never remembered. *@
                        <select id="aiMode" class="aiField aiSelect" @onchange="PickRung" @onclick:stopPropagation="true" title="@ModeHint()">
                            @foreach (ToolApprovalMode mode in AssistantPrompt.Rungs)
                            {
                                <option value="@mode" selected="@(mode == State.Chat.Mode)">@AssistantPrompt.RungLabel(mode)</option>
                            }
                        </select>
                    }
                    else
                    {
                        @* What goes with the request, where the assistant has how far it may go on its own. *@
                        <label class="aiBarCheck" title="Send the script currently in the editor and ask for it to be changed, rather than starting again." @onclick:stopPropagation="true">
                            <input type="checkbox" class="aiRevise" checked="@_revise" disabled="@(Busy || Writer.CurrentScript is not { Length: > 0 })"
                                   @onchange="e => ReviseAsync(e.Value is true)" /> Revise the current script
                        </label>
                        <label class="aiBarCheck" title="Send what the last run printed, so a failure can be read and worked around." @onclick:stopPropagation="true">
                            <input type="checkbox" class="aiIncludeOutput" checked="@_includeOutput" disabled="@(Busy || Writer.RecentOutput is not { Length: > 0 })"
                                   @onchange="e => IncludeOutputAsync(e.Value is true)" /> Include the last run's output
                        </label>
                    }

                    @* Who answers, rather than what is being said to them: at the far end, beside Send. *@
                    <div class="aiComposerEnd" @onclick:stopPropagation="true">
                        <span class="aiToolHolder" @ref="_toolRoot">
                            @if (_toolsOpen)
                            {
                                <div id="aiToolPicker" class="aiToolPicker" role="dialog" aria-label="@PickerName()" tabindex="-1" data-popup @ref="_toolCard">
                                    @if (Writer is null)
                                    {
                                        <div class="aiToolPickerHead">Tools the assistant may use</div>

                                        @foreach (var (heading, tools) in ToolGroups())
                                        {
                                            <div class="aiToolPickerGroup">
                                                <span class="aiToolPickerGroupName">@heading</span>
                                                <button type="button" class="aiLink" @onclick="() => SetTools(tools, true)">all</button>
                                                <button type="button" class="aiLink" @onclick="() => SetTools(tools, false)">none</button>
                                            </div>

                                            <div class="aiToolPickerTools">
                                                @foreach (LlmTool tool in tools)
                                                {
                                                    <label class="aiToolPickerTool" title="@tool.Description.Split('\n')[0]">
                                                        <input type="checkbox" data-tool="@tool.Name" checked="@(!State.Chat.ToolsOff.Contains(tool.Name))"
                                                               @onchange="e => SwitchTool(tool.Name, e.Value is true)" />
                                                        <span>@tool.Name.Replace('_', ' ')</span>
                                                    </label>
                                                }
                                            </div>
                                        }

                                        <div class="aiToolPickerNote">
                                            A tool switched off is not offered to the model, which is told so. It stays off in the next conversation too,
                                            until the page is reloaded.
                                        </div>
                                    }
                                    else if (Writer.IsSequence)
                                    {
                                        @* Which catalogs is not a question in a console's script window: the script runs on the
                                           instrument whose console it was opened from. Several at once is the point of this one. *@
                                        <div class="aiToolPickerHead">Catalogs the script may use</div>

                                        <div class="aiToolPickerTools">
                                            @foreach (SessionDto s in _sessions)
                                            {
                                                <label class="aiToolPickerTool" title="Include this instrument's catalog in what the model is allowed to use.">
                                                    <input type="checkbox" class="aiCatalogTick" checked="@(!_left.Contains(s.Id))" @onchange="e => TickCatalogAsync(s.Id, e.Value is true)" />
                                                    <span>@s.ProfileName</span>
                                                </label>
                                            }
                                        </div>

                                        @if (_sessions.Count == 0)
                                        {
                                            <div class="aiToolPickerNote">No instrument is connected.</div>
                                        }
                                    }

                                    <div class="aiToolPickerHead">This conversation</div>

                                    <div class="aiToolPickerAction">
                                        <button id="aiCompact" type="button" class="aiAct" disabled="@(WhyNotCompactNow() is not null)"
                                                title="Replace the conversation so far with a briefing the assistant carries on from." @onclick="CompactFromMenuAsync">Compact</button>
                                        <span id="aiCompactPrice" class="aiToolPickerPrice">@CompactLine()</span>
                                    </div>
                                </div>
                            }

                            <button id="aiToolPickerToggle" type="button" class="aiBarButton aiToolPickerToggle @(_toolsOpen ? "aiBarButtonOn" : null)" disabled="@Busy"
                                    aria-pressed="@(_toolsOpen ? "true" : "false")" aria-label="@PickerName()" title="@PickerTitle()" @onclick="ToggleTools">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                                    <line x1="2" y1="4" x2="14" y2="4" stroke-linecap="round" />
                                    <line x1="2" y1="8" x2="14" y2="8" stroke-linecap="round" />
                                    <line x1="2" y1="12" x2="14" y2="12" stroke-linecap="round" />
                                    <circle cx="5.5" cy="4" r="1.7" fill="currentColor" />
                                    <circle cx="10.5" cy="8" r="1.7" fill="currentColor" />
                                    <circle cx="7" cy="12" r="1.7" fill="currentColor" />
                                </svg>
                                @if (PickerOff() > 0)
                                {
                                    <span id="aiToolPickerCount" class="aiFilesCount">@PickerOff()</span>
                                }
                            </button>
                        </span>

                        <AiModelMenu Models="MenuModels()" SelectedId="@_connection?.Id" Chosen="@ModelSaid()" EffortSaid="@EffortSaid()"
                                     Levels="MenuLevels()" Effort="@State.Effort" SupportsFast="@(Writer is null && AiModels.SupportsFast(_connection))" Fast="State.Fast"
                                     Disabled="Busy" Title="@ModelTitle()" OnModel="PickAsync" OnEffort="e => State.Effort = e"
                                     FastChanged="on => State.Fast = on" OnManage="() => Ai.AskForSettingsAsync()" />

                        @* What the next request costs before it is sent, and what has been spent: the (i)
                           shows it in a card while pointed at, and a press keeps it on a line under the box. *@
                        @if (_connection is not null)
                        {
                            <div class="aiMeterHolder">
                                <button id="aiMeterToggle" type="button" class="aiBarButton @(State.MeterOn ? "aiBarButtonOn" : null)"
                                        aria-pressed="@(State.MeterOn ? "true" : "false")" aria-label="@MeterLabel()" @onclick="() => State.MeterOn = !State.MeterOn">
                                    <svg viewBox="0 0 16 16" aria-hidden="true">
                                        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="8" cy="4.9" r="0.9" fill="currentColor" />
                                        <path d="M8 7.2v4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    </svg>
                                </button>

                                @* Only while the line is off: with it on, the card would say what is already under the box. *@
                                @if (!State.MeterOn)
                                {
                                    <div id="aiMeterCard" class="aiMeterCard" role="tooltip">
                                        <span class="aiMeterNote">Press the (i) to keep this under the box</span>
                                        @MeterLines()
                                    </div>
                                }
                            </div>
                        }

                        @* Send and Stop are one button, in one place: a double-click on Send must not stop
                           what it sent, so a press counted as the second of a pair is let go. *@
                        <button id="aiSend" type="button" class="aiSendStop @(Busy ? "aiSendStopping" : null)" aria-label="@(Busy ? "Stop" : Writer is null ? "Send" : "Write Script")"
                                @onclick="SendOrStopAsync" disabled="@(!Busy && !CanSend)" title="@SendTitle()">
                            @if (Busy)
                            {
                                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4.5" y="4.5" width="7" height="7" rx="1" fill="currentColor" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M8 13V3.5M3.8 7.6 8 3.4l4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                        </button>

                        @* The microphone: speech into the box, by the browser's own recognition as the words are said, or
                           recorded and written out by the AI provider, chosen under AI settings. Red while it listens. *@
                        <button id="aiMic" type="button" class="aiBarButton aiMic @(_listening ? "aiMicOn" : null) @(_transcribing ? "aiMicBusy" : null) @(MicUsable ? null : "aiMicOff")"
                                aria-pressed="@(_listening ? "true" : "false")" aria-label="@MicLabel()" title="@MicTitle()" disabled="@_transcribing" @onclick="MicAsync">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                                <rect x="5.75" y="1.75" width="4.5" height="8" rx="2.25" />
                                <path d="M3.6 7.6a4.4 4.4 0 0 0 8.8 0M8 12v2.2M5.9 14.2h4.2" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            @if (_connection is not null && State.MeterOn)
            {
                <div id="aiMeter" class="aiMeter">
                    @MeterLines()
                </div>
            }
        </div>
    </ChildContent>
</ToolWindow>

@code {
    /// <summary>The window has shut, by its ✕ or Esc. What it holds stays in its state.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    /// <summary>What the script editor that opened this says about itself; null when this is the bench's AI assistant.</summary>
    [Parameter] public ScriptWriterContext? Writer { get; set; }

    /// <summary>Where a writer's Use This Script puts the script.</summary>
    [Parameter] public EventCallback<string> OnUse { get; set; }

    /// <summary>What this window holds between openings: the assistant's, or the writer's for its language.</summary>
    private AiWindowState State => Writer is null ? Main : Scripts.For(Writer.IsSequence);

    private const string NoConnection = "No AI connection is set up. AI settings… in the gear adds one.";
    private const string WhyBusy = "Not while an answer is coming. Stop it first.";
    private const string ContinueWord = "Continue";
    private const int MicLevelBars = 12;

    /// <summary>What an empty conversation offers to start from, each put in the box by a press rather than sent.</summary>
    private static readonly string[] Examples =
    [
        AssistantPrompt.StatusQuestion,
        AssistantPrompt.ErrorsQuestion,
        "Write a script that reads every instrument once and prints the results",
    ];

    /// <summary>One of the window's slash commands: its name, what it does, why it cannot run now (or null), and what it does with any words after its name.</summary>
    private sealed record SlashCommand(string Name, string What, string? WhyNot, Func<string, Task> Run);

    private ToolWindow? _window;
    private ElementReference _zone;
    private ElementReference _row;
    private ElementReference _box;
    private ElementReference _transcript;
    private ElementReference _toolRoot;
    private ElementReference _toolCard;
    private ElementReference _cameraCard;
    private ElementReference _cameraVideo;
    private ElementReference _micLevel;
    private InputFile? _input;
    private DotNetObjectReference<Assistant>? _self;
    private bool _disposed;

    private AiConnections _book = new();
    private AiConnection? _connection;
    private IReadOnlyList<BenchInstrument> _benchNow = [];
    private List<ChatSummary> _chatList = [];
    private string? _confirmingDelete;
    private string _attachProblem = "";
    private string _filesProblem = "";
    private string _speechProblem = "";
    private string _cameraProblem = "";
    private int _filesDrawn;
    private bool _toolsOpen;
    private bool _toolsFocused;
    private bool _focusBox = true;
    private bool _caretToEnd;
    private bool _cameraOpen;
    private bool _cameraStarted;
    private bool _listening;
    private bool _micLevelStarted;
    private bool _browserSpeech;
    private bool _transcribing;
    private SpeechMode _speechMode = SpeechMode.Browser;
    private SpeechMode _listeningMode = SpeechMode.Browser;
    private CancellationTokenSource? _transcribeStop;
    private int _drawnTurns = -1;

    /// <summary>The marked command in the list, and the words the list was put away at by Esc, until they change.</summary>
    private int _slashMarked;
    private string? _slashPutAwayFor;

    // The writer's own: what the bench offers it, which catalogs were unticked, what goes with a
    // request, and how long one is before the conversation, the files and the box.
    private IReadOnlyList<SessionDto> _sessions = [];
    private readonly HashSet<string> _left = [];
    private bool _revise;
    private bool _includeOutput;
    private int _promptCharacters;
    private string _measuredFor = "";

    private bool Busy => State.Chat.Generating;

    /// <summary>Brings the window forward when it is asked for again.</summary>
    public Task RaiseAsync() => _window?.RaiseAsync() ?? Task.CompletedTask;

    protected override async Task OnInitializedAsync()
    {
        State.Chat.Changed += OnChatChanged;
        State.Changed += OnStateChanged;
        State.Store.Changed += OnChatsChanged;
        Ai.ConnectionsChanged += OnConnectionsChanged;
        Bench.SessionsChanged += OnSessionsChanged;
        Preferences.Changed += OnPreferenceChanged;
        _speechMode = await Preferences.SpeechAsync();

        // Ticked when there is something for them to send, as the desktop ticks them: a switch
        // that is on and has nothing to offer is a switch that lies.
        _revise = Writer?.CurrentScript is { Length: > 0 };
        _includeOutput = Writer?.RecentOutput is { Length: > 0 };

        await PickConnectionAsync();
        await ReadBenchAsync();
        await ReadChatsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_disposed) return;
        if (first)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("lec.assistant.box", _box, _input?.Element, _self);
            await JS.InvokeVoidAsync("lec.assistant.drop", _zone, _input?.Element);
            await JS.InvokeVoidAsync("lec.assistant.splits", _row);
            await JS.InvokeVoidAsync("lec.assistant.outside", _toolRoot, _self, nameof(ToolsDismissed));
            await JS.InvokeVoidAsync("lec.assistant.escape", _toolRoot, _self, nameof(ToolsDismissed));
            _browserSpeech = await JS.InvokeAsync<bool>("lec.speech.browserSupported");
            StateHasChanged();
        }
        if (_focusBox)
        {
            _focusBox = false;
            await _box.FocusAsync();
        }
        if (_caretToEnd)
        {
            _caretToEnd = false;
            await JS.InvokeVoidAsync("lec.assistant.caretToEnd", _box);
        }
        if (_toolsOpen && !_toolsFocused)
        {
            _toolsFocused = true;
            await JS.InvokeVoidAsync("lec.focus", _toolCard);
        }
        if (!_toolsOpen) _toolsFocused = false;

        if (_listening && !_micLevelStarted)
        {
            _micLevelStarted = true;
            await JS.InvokeVoidAsync("lec.speech.showLevel", _micLevel);
        }
        else if (!_listening)
        {
            _micLevelStarted = false;
        }

        if (_cameraOpen && !_cameraStarted)
        {
            _cameraStarted = true;
            await JS.InvokeVoidAsync("lec.assistant.escape", _cameraCard, _self, nameof(CameraEscape));
            string why = await JS.InvokeAsync<string>("lec.assistant.camera.open", _cameraVideo);
            if (why.Length > 0)
            {
                _cameraProblem = why;
                StateHasChanged();
            }
        }
        else if (!_cameraOpen)
        {
            _cameraStarted = false;
        }

        int count = State.Chat.Turns.Count;
        if (count != _drawnTurns)
        {
            _drawnTurns = count;
            await JS.InvokeVoidAsync("lec.scrollToEnd", _transcript);
        }
        await JS.InvokeVoidAsync("lec.assistant.fit", _box);
    }

    // ------------------------------------------------------------------- what it is told

    private async Task PickConnectionAsync()
    {
        try
        {
            _book = await Ai.LoadConnectionsAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _book = new AiConnections();
            State.Say("The connections could not be read: " + e.Message);
        }
        _connection = _book.Selected?.Clone();
        if (State.Effort.Length > 0 && !AiModels.EffortLevels(_connection).Contains(State.Effort)) State.Effort = "";
        if (!AiModels.SupportsFast(_connection)) State.Fast = false;
    }

    private async Task ReadBenchAsync()
    {
        try
        {
            _benchNow = await State.BenchAsync();
            if (Writer is not null) _sessions = await Bench.SessionsAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _benchNow = [];
            _sessions = [];
        }
        await MeasureRequestAsync();
    }

    // ------------------------------------------------------------------- the script writer's

    /// <summary>The instruments a script may use: the console's it was opened from, or those on the bench still ticked.</summary>
    private List<string> Chosen()
        => Writer?.Session is { Length: > 0 } one ? [one] : [.. _sessions.Select(s => s.Id).Where(id => !_left.Contains(id))];

    /// <summary>The request as the switches stand. A multi-instrument editor's script goes up for its names whether or not it is to be revised.</summary>
    private ScriptWriterAsk WriterAsk() => new(
        Chosen(), Writer!.IsSequence,
        _revise ? Writer.CurrentScript : null,
        _includeOutput ? Writer.RecentOutput : null,
        Writer.IsSequence ? Writer.CurrentScript : null,
        Writer.IsSequence ? Writer.Picks : null);

