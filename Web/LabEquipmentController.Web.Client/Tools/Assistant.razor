    private async Task OpenChatAsync(string id)
    {
        if (Busy)
        {
            State.Say(WhyBusy);
            return;
        }
        if (_confirmingDelete is not null) return;
        string? why;
        try
        {
            why = await State.OpenAsync(id);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            why = "That chat could not be read: " + e.Message;
        }
        if (why is not null)
        {
            State.Say(why);
            await ReadChatsAsync();
        }
        _drawnTurns = -1;
        Redraw();
    }

