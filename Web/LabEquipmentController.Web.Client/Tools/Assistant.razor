    private async Task PickFilesAsync() => await JS.InvokeVoidAsync("lec.assistant.pick", _input?.Element);

    /// <summary>
    /// A screenshot, which the browser asks for: a screen, a window or a tab. It goes in through
    /// the file input as a chosen file does; a picker closed without a choice says nothing.
    /// </summary>
    private async Task ScreenshotAsync()
