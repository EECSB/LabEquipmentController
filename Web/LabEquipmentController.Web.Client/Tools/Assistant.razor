    /// <summary>What a run was billed for, in full, over the line under the answer it ended.</summary>
    private static string UsageTitle(ChatTurn turn)
    {
        if (turn.Usage is not LlmUsage used) return "";

        var said = new System.Text.StringBuilder($"What {turn.Model} was billed for here, every request of it: {AiPricing.Count(used.InputTokens)} tokens read");
        if (used.CachedInputTokens > 0 || used.CacheWriteTokens > 0)
            said.Append($", {AiPricing.Count(used.CachedInputTokens)} of them from the provider's cache and {AiPricing.Count(used.CacheWriteTokens)} written into it");
        said.Append($"; {AiPricing.Count(used.OutputTokens)} written");
        if (used.ReasoningTokens > 0) said.Append($", {AiPricing.Count(used.ReasoningTokens)} of them thinking");
        if (turn.Cost is null) said.Append(". There is no rate for this model, so no cost: give it one under AI settings");
        return said.Append('.').ToString();
    }

