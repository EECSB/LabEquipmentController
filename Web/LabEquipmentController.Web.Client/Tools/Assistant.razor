    private bool MicUsable => _speechMode == SpeechMode.Provider || _browserSpeech;

    private string MicLabel() => _transcribing ? "Writing out what you said" : _listening ? "Stop listening" : "Speak your question";

    /// <summary>What a press does in the way it is set to, and the other way and what it is better at.</summary>
    private string MicTitle()
    {
        if (_transcribing) return "Writing out what you said…";
        if (_listening && _listeningMode == SpeechMode.Provider) return "Recording: press to stop, and the AI provider writes it out.";
        if (_listening) return "Listening: press to stop.";
        if (_speechMode == SpeechMode.Provider)
            return "Speak your question: press, talk, and press again. An OpenAI or Gemini model writes it out, told the instruments' names, and the provider bills it. For live words as you talk, switch Speech to text to Browser under AI settings.";
        if (!_browserSpeech)
            return "This browser has no speech recognition of its own. Switch Speech to text to AI provider under AI settings, and the microphone records instead.";
        return "Speak your question: your browser writes it into the box as you talk (Chrome and Edge send the audio to Google or Microsoft). For better accuracy with SCPI and numbers, switch Speech to text to AI provider under AI settings.";
    }

    private async Task MicAsync()
    {
        if (_transcribing) return;
        _speechProblem = "";

        if (_listening)
        {
            await StopSpeechAsync();
            return;
        }

        _listeningMode = _speechMode;

        if (_speechMode == SpeechMode.Browser)
        {
            if (!_browserSpeech)
            {
                _speechProblem = "This browser has no speech recognition of its own: Chrome and Edge have. Or switch Speech to text to AI provider under AI settings, and the microphone records instead.";
                return;
            }
            _listening = await JS.InvokeAsync<bool>("lec.speech.startListening", _box, _self);
            if (!_listening) _speechProblem = "The browser's speech recognition could not start. Press the microphone again.";
            return;
        }

        string why = await JS.InvokeAsync<string>("lec.speech.startRecording", _self);
        if (why.Length > 0)
        {
            _speechProblem = why;
            return;
        }
        _listening = true;
    }

    private async Task StopSpeechAsync()
    {
        if (_listeningMode == SpeechMode.Browser)
        {
            await JS.InvokeVoidAsync("lec.speech.stopListening");
            return;
        }

        _listening = false;
        _transcribing = true;
        StateHasChanged();

        string recorded = "";
        try
        {
            recorded = await JS.InvokeAsync<string>("lec.speech.stopRecording");
        }
        catch (JSException e)
        {
            _speechProblem = "The recording could not be read: " + e.Message;
        }

        await TranscribeAsync(recorded);
        _transcribing = false;
        Redraw();
    }

    /// <summary>The recording, written out by the model picked when it can, or the first saved one that can, told the words to expect.</summary>
    private async Task TranscribeAsync(string recorded)
    {
        if (recorded.Length == 0)
        {
            if (_speechProblem.Length == 0) _speechProblem = "Nothing was recorded.";
            return;
        }

        bool usable(AiConnection one) => Ai.WhyNotAsk(one) is null;
        if (SpeechTranscriber.Pick(_connection is not null && usable(_connection) ? _connection : null, _book.Items.Where(usable)) is not AiConnection model)
        {
            _speechProblem = "Speech written out by the AI provider takes an OpenAI or Gemini model: add one under AI settings, or switch Speech to text to Browser there. Claude models take no audio.";
            return;
        }

        var stop = new CancellationTokenSource();
        _transcribeStop = stop;
        try
        {
            var names = _benchNow.SelectMany(i => new[] { InstrumentProfile.ParseIdentity(i.Identity).Item2, i.Host });
            var (text, problem) = await Ai.TranscribeAsync(model, Convert.FromBase64String(recorded), SpeechTranscriber.Vocabulary(names), stop.Token);

            if (problem is not null)
            {
                _speechProblem = problem;
                return;
            }
            if (string.IsNullOrWhiteSpace(text))
            {
                _speechProblem = "Nothing was heard in the recording.";
                return;
            }

            State.Draft = string.IsNullOrWhiteSpace(State.Draft) ? text.Trim() : State.Draft.TrimEnd() + " " + text.Trim();
        }
        catch (OperationCanceledException)
        {
            // The window went while it was being written out.
        }
        catch (HttpRequestException e)
        {
            _speechProblem = "The recording could not reach the server: " + e.Message;
        }
        finally
        {
            if (_transcribeStop == stop) _transcribeStop = null;
            stop.Dispose();
        }
    }

    /// <summary>The recognizer stopped, by the press that asked it to, a silence or a problem to say; or a recording reached its limit.</summary>
    [JSInvokable]
    public async Task OnSpeechEnded(string problem)
    {
        if (problem == "limit")
        {
            if (_listening && _listeningMode == SpeechMode.Provider) await StopSpeechAsync();
            StateHasChanged();
            return;
        }

        _listening = false;
        if (problem.Length > 0) _speechProblem = problem;
        StateHasChanged();
    }

