    /// <summary>
    /// Every file that comes in, from Attach Files…, a paste, a drop or a screenshot: checked for
    /// what it is and how big before it is read, then put in the box by the conversation, which
    /// holds it to what a question and a conversation can carry.
    /// </summary>
    private async Task AttachAsync(InputFileChangeEventArgs e)
    {
        var problems = new List<string>();
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(100);
        }
        catch (InvalidOperationException)
        {
            _attachProblem = "That is more files than one question can carry.";
            return;
        }

        int index = 0;
        foreach (IBrowserFile file in files)
        {
            string name = Named(file.Name, file.ContentType, ++index, files.Count);
            if (AiAttachment.Refusal(name, file.ContentType, file.Size) is string refused)
            {
                problems.Add(refused);
                continue;
            }
            try
            {
                await using Stream stream = file.OpenReadStream(maxAllowedSize: Math.Max(1, file.Size));
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                if (State.Chat.Attach(new AiAttachment(name, file.ContentType, memory.ToArray())) is string problem)
                    problems.Add(problem);
            }
            catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException)
            {
                problems.Add($"{name} could not be read: {ex.Message}");
            }
        }
        _attachProblem = string.Join(" ", problems);
        Redraw();
    }

    /// <summary>A pasted screenshot arrives as image.png, every one of them: named for when it was pasted, as the desktop names one.</summary>
    private static string Named(string name, string type, int index, int count)
    {
        if (name.Length > 0 && !name.Equals("image.png", StringComparison.OrdinalIgnoreCase)) return name;
        string stamp = DateTime.Now.ToString("yyyy-MM-dd-HHmmss", System.Globalization.CultureInfo.InvariantCulture);
        string extension = type switch { "image/jpeg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", _ => ".png" };
        return count > 1 ? $"pasted-{stamp}-{index}{extension}" : $"pasted-{stamp}{extension}";
    }

    private void Unattach(AiAttachment file)
    {
        State.Chat.Unattach(file);
        _attachProblem = "";
    }

    /// <summary>
    /// Ticks a sent file back in, or out. Unticking is always allowed; ticking one back is held to
    /// the conversation's budget, and a refusal leaves the box as it was and says why under the list.
    /// </summary>
    private void Include(AiAttachment file, bool include)
    {
        _filesProblem = State.Chat.Include(file, include) ?? "";
        // Drawn afresh, so a tick the conversation refused does not stay ticked on screen.
        _filesDrawn++;
    }

    private string FilesFoot(List<(ChatTurn Question, AiAttachment File)> sent)
    {
        long tokens = _connection is null ? 0 : sent.Where(s => !s.File.Excluded).Sum(s => AiEstimate.Attachment(s.File, _connection));
        return tokens > 0
            ? $"The ticked files add about {AiPricing.About(tokens)} tokens to every question."
            : sent.Count > 0 ? "No ticked file goes with the questions now." : "";
    }

    private static string Cut(string text, int most)
    {
        string flat = string.Join(" ", text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return flat.Length <= most ? flat : flat[..most].TrimEnd() + "…";
    }

    // ------------------------------------------------------------------- a proposal used

    /// <summary>
    /// Use This Script: an instrument's script into that console's script editor, a sequence into
    /// the multi-instrument editor, on the bench page (ScriptHandoff). Nothing runs until Run.
    /// </summary>
    private async Task UseScriptAsync(ChatTurn turn)
    {
        if (turn.Proposal is not string script) return;
        (bool sequence, string? named) = AssistantPrompt.ProposalTarget(turn.ArgumentsJson);

        string? sessionId = null;
        if (!sequence)
        {
            BenchInstrument? instrument = await State.Tools.FindInstrumentAsync(named, CancellationToken.None);
            if (instrument is null)
            {
                State.Say("That script's instrument is not open any more. Copy it from the card instead.");
                return;
            }
            sessionId = instrument.Key;
        }

        State.Say(await Handoff.HandAsync(sessionId, script) ?? (sequence
            ? "The script is in the multi-instrument editor. Nothing runs until you press Run there."
            : "The script is in that console's script editor. Nothing runs until you press Run there."));
    }

    private static string KindOf(ChatTurn turn) => turn.Kind switch
    {
        ChatTurn.User => "you",
        ChatTurn.Assistant => "answer",
        ChatTurn.Tool => "tool",
        ChatTurn.Error => "problem",
        ChatTurn.Paused => "paused",
        ChatTurn.Summary => "briefing",
        _ => "note",
    };

    // ------------------------------------------------------------------- staying current

    private Task OnChatChanged()
    {
        Redraw();
        return Task.CompletedTask;
    }

    private void OnStateChanged() => Redraw();

    private async Task OnChatsChanged()
    {
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            await ReadChatsAsync();
            Redraw();
        });
    }

    private async Task OnConnectionsChanged()
    {
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            await PickConnectionAsync();
            Redraw();
        });
    }

    private void OnSessionsChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await ReadBenchAsync();
            Redraw();
        });
    }

    private void Redraw()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private async Task Closed() => await OnClosed.InvokeAsync();

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        State.Chat.Changed -= OnChatChanged;
        State.Changed -= OnStateChanged;
        Ai.Chats.Changed -= OnChatsChanged;
        Ai.ConnectionsChanged -= OnConnectionsChanged;
        Bench.SessionsChanged -= OnSessionsChanged;
        _self?.Dispose();
        return ValueTask.CompletedTask;
    }
}
