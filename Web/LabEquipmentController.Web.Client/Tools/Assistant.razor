    /// <summary>A chat as text, downloaded: the one on screen for <c>/export</c> and its row, another as it was kept.</summary>
    private async Task ExportAsync(string? id)
    {
        if (id is null && State.Chat.Turns.Count == 0) return;
        (string Title, string Text)? written;
        try
        {
            written = await State.TranscriptAsync(id);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            State.Say("That chat could not be read: " + e.Message);
            return;
        }
        if (written is not (string title, string text))
        {
            State.Say("That chat is gone: it was deleted, or its file will not read.");
            await ReadChatsAsync();
            return;
        }
        string name = FileNameFor(title);
        await JS.InvokeVoidAsync("lec.download", name, "text/plain;charset=utf-8", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text)));
        State.Say("Saved as " + name + ".");
    }

    private static string FileNameFor(string title)
    {
        char[] bad = ['\\', '/', ':', '*', '?', '"', '<', '>', '|'];
        string safe = new string(title.Select(c => bad.Contains(c) || char.IsControl(c) ? '-' : c).ToArray()).Trim().TrimEnd('.');
        if (safe.Length > 60) safe = safe[..60].Trim();
        return (safe.Length > 0 ? safe : "chat") + $" {DateTime.Now:yyyy-MM-dd}.txt";
    }

    private static string When(DateTime kept)
    {
        DateTime local = kept.Kind == DateTimeKind.Utc ? kept.ToLocalTime() : kept;
        DateTime now = DateTime.Now;
        if (local.Date == now.Date) return local.ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture);
        if (local.Year == now.Year) return local.ToString("d MMM, HH:mm", System.Globalization.CultureInfo.CurrentCulture);
        return local.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
    }

