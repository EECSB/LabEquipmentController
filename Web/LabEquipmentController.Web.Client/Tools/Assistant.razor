            : $"{s.ProfileName}: no catalog — only *IDN?, *RST, *CLS and *OPC? can be checked";

    /// <summary>A real request, for the kind of editor this window was opened from.</summary>
    private string WriterExample => Writer!.IsSequence
        ? "Sweep the generator from 100 Hz to 100 kHz in 20 log steps and record the scope's peak-to-peak voltage at each one."
        : "Set a 1 kHz sine at 2 Vpp on channel 1, turn the output on, wait a second, then read it back.";

    /// <summary>
    /// Asks the server how long a request is before the conversation, the files and the box: the
    /// catalogs are on the server, and they are most of it. Asked again only when what goes with a
    /// request has changed.
    /// </summary>
    private async Task MeasureRequestAsync()
    {
        if (Writer is null) return;

        ScriptWriterAsk ask = WriterAsk();
        string asking = $"{string.Join(',', ask.SessionIds)}|{ask.CurrentScript}|{ask.RecentOutput}|{ask.EditorScript}";
        if (asking == _measuredFor) return;
        _measuredFor = asking;

        _promptCharacters = ask.SessionIds.Count == 0
            ? 0
            : await Bench.AiScriptSizeAsync(new AiScriptRequest(
                "", ask.SessionIds, ask.IsSequence, ask.CurrentScript, ask.RecentOutput,
                EditorScript: ask.EditorScript, Picks: ask.Picks));
        Redraw();
    }

    private async Task ReviseAsync(bool on)
    {
        _revise = on;
        await MeasureRequestAsync();
    }

    private async Task IncludeOutputAsync(bool on)
    {
        _includeOutput = on;
        await MeasureRequestAsync();
    }

    private async Task TickCatalogAsync(string id, bool on)
    {
        if (on) _left.Remove(id);
        else _left.Add(id);
        await MeasureRequestAsync();
