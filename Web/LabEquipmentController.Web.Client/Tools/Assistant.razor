    private async Task SendFromBoxAsync()
    {
        string text = State.Draft;
        if (await TryRunSlashAsync(text)) return;
        if (CanSend) await SendAsync(text, fromBox: true);
    }

    private async Task SendAsync(string text, bool fromBox)
    {
        if (Busy || string.IsNullOrWhiteSpace(text)) return;
        if (WhyNotAskNow() is string why)
        {
            State.Say(why);
            return;
        }

        if (fromBox) State.Draft = "";
        _attachProblem = "";
        ChatOutcome outcome = Writer is null
            ? await Main.SendAsync(text, _connection!)
            : await Scripts.For(Writer.IsSequence).SendAsync(text, _connection!, WriterAsk());

        // A question that failed gave its files back to the box; its words go back with them when
        // the box is still empty, so asking again is one press. A request to the writer that failed
        // always does: it is a sentence somebody wrote to be sent, and nothing was done with it.
        if (outcome == ChatOutcome.Failed && (Writer is not null || State.Chat.GaveFilesBack) && State.Draft.Length == 0)
            State.Draft = text;

        // The editor may have been changed while this was out.
        await MeasureRequestAsync();
        Redraw();
    }

