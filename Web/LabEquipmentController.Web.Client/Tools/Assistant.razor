    private Task OnChatChanged()
    {
        Redraw();
        return Task.CompletedTask;
    }

    private void OnStateChanged() => Redraw();

    private async Task OnChatsChanged()
    {
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            await ReadChatsAsync();
            Redraw();
        });
    }

    private async Task OnConnectionsChanged()
    {
        if (_disposed) return;
        await InvokeAsync(async () =>
        {
            await PickConnectionAsync();
            Redraw();
        });
    }

    private void OnSessionsChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await ReadBenchAsync();
            Redraw();
        });
    }

    private void Redraw()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private async Task Closed() => await OnClosed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        State.Chat.Changed -= OnChatChanged;
        State.Changed -= OnStateChanged;
        State.Store.Changed -= OnChatsChanged;
        Ai.ConnectionsChanged -= OnConnectionsChanged;
        Bench.SessionsChanged -= OnSessionsChanged;
        Preferences.Changed -= OnPreferenceChanged;
        _transcribeStop?.Cancel();
        try
        {
            await JS.InvokeVoidAsync("lec.speech.cancel");
            await JS.InvokeVoidAsync("lec.assistant.camera.close");
            await JS.InvokeVoidAsync("lec.assistant.outsideOff", _toolRoot);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or InvalidOperationException)
        {
            // The page is going: there is nothing left to stop.
        }
        _self?.Dispose();
    }
