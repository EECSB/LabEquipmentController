    /// <summary>
    /// Every file that comes in, from the paperclip, a paste, a drop, the camera or a screenshot:
    /// checked for what it is and how big before it is read, then put in the box by the
    /// conversation, which holds it to what a question and a conversation can carry.
    /// </summary>
    private async Task AttachAsync(InputFileChangeEventArgs e)
    {
        var problems = new List<string>();
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(100);
        }
        catch (InvalidOperationException)
        {
            _attachProblem = "That is more files than one question can carry.";
            return;
        }

        int index = 0;
        foreach (IBrowserFile file in files)
        {
            string name = Named(file.Name, file.ContentType, ++index, files.Count);
            if (AiAttachment.Refusal(name, file.ContentType, file.Size) is string refused)
            {
                problems.Add(refused);
                continue;
            }
            try
            {
                await using Stream stream = file.OpenReadStream(maxAllowedSize: Math.Max(1, file.Size));
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                if (State.Chat.Attach(new AiAttachment(name, file.ContentType, memory.ToArray())) is string problem)
                    problems.Add(problem);
            }
            catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException)
            {
                problems.Add($"{name} could not be read: {ex.Message}");
            }
        }
        _attachProblem = string.Join(" ", problems);
        Redraw();
    }

    /// <summary>A pasted screenshot arrives as image.png, every one of them: named for when it was pasted, as the desktop names one.</summary>
    private static string Named(string name, string type, int index, int count)
    {
        if (name.Length > 0 && !name.Equals("image.png", StringComparison.OrdinalIgnoreCase)) return name;
        string stamp = DateTime.Now.ToString("yyyy-MM-dd-HHmmss", System.Globalization.CultureInfo.InvariantCulture);
        string extension = type switch { "image/jpeg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", _ => ".png" };
        return count > 1 ? $"pasted-{stamp}-{index}{extension}" : $"pasted-{stamp}{extension}";
    }

