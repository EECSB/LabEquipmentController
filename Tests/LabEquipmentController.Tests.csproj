<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\LabEquipmentController.Core.csproj" />
    <!-- The CLI's argument parsing and output shapes are testable without a network; the
         WinForms app is not referenced here and never should be. -->
    <ProjectReference Include="..\Cli\LabEquipmentController.Cli.csproj" />
    <!-- The web server is started in memory by WebApplicationFactory. -->
    <ProjectReference Include="..\Web\LabEquipmentController.Web\LabEquipmentController.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Bench tests decode a screenshot and read the DPAPI-protected key; both live outside
         the base framework, and neither is used by the offline suite. Kept on the same
         major as the target framework — these two ship in lockstep with the runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Spins the web server up in memory, so the API is tested through real HTTP without
         binding a port or needing an instrument. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>